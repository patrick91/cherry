#!/usr/bin/env bash
# Devices (docs/specs/remote-devices.md) over a real SSH connection to this
# Mac, without admin rights: a private sshd on 127.0.0.1, run as you, with its
# own host key, authorized key and config under a temporary directory.
#
#   Scripts/test-remote-mac-loopback [--skip-build] [--no-install]
#
# It needs /usr/sbin/sshd (it runs as you; no Remote Login setting changes)
# and the debug helpers (Scripts/build-host debug, or CARGO_TARGET_DIR), and
# for the install check the Swift tests (built first unless --skip-build).
#
# Nothing of yours is used or changed:
# - ssh always runs with `-F` and a private config (its own key, known_hosts
#   file and no agent), so ~/.ssh is never read;
# - sshd forces every command through a wrapper that sets a private HOME and
#   CHERRY_HOST_SOCKET, and refuses a gateway without an explicit --socket;
#   every `cherry` here passes that private socket too, so the daemon it
#   talks to is a private one this script starts and stops (never
#   /tmp/cherry-host-$UID);
# - sshd listens on 127.0.0.1 only, and everything it started is stopped by
#   its pid or by the private socket path when the script ends.
#
# It checks what the app does over SSH for a device: a BatchMode login, the
# Add Mac check (`cherry-host version --json` and `status --json` through
# `sh -s`), sessions created, listed and ended through `cherry --host`, with
# and without --remote-host-path, and (unless --no-install) Install & Add's
# copy: the app's installer (the Swift test
# RemoteDeviceRealHostInstallRunsTheRealCopyOverSSH, pointed at this sshd)
# sends this Cherry's cherry and cherry-host as a tar stream into the
# private home, runs xattr -c, codesign --verify --strict and cherry-host
# version --json there, checks the hashes, skips a second copy of the same
# files; then `cherry --host` runs the installed cherry-host's gateway.
# Its sshd allows 3 sessions per connection (MaxSessions 3), and the Swift
# test RemoteDeviceRealHostShardsSSHMastersAboveTheChannelCap checks against
# it that the app opens a second SSH master (a shard) once the first is full,
# where a fourth session on the first is refused. Its sshd allows local
# forwards to its own loopback only (PermitOpen) and no remote TCP listener
# (PermitListen none),
# and the Swift test RemoteDeviceRealHostForwardsAPortThroughTheSSHMaster
# forwards a port through an app-style master (ClearAllForwardings=yes) with
# `ssh -O forward`, fetches a page served on the "remote" side through it,
# and checks that `-O cancel` and the master's end take the forward away.
# Its sshd allows Unix socket forwarding (AllowStreamLocalForwarding yes,
# the default, with StreamLocalBindUnlink no, the default; sshd also refuses
# a remote Unix socket forward unless AllowTcpForwarding allows remote
# forwards, so it is yes, with PermitListen none: no remote TCP listener),
# and the Swift
# test RemoteDeviceRealHostForwardsCherryMCPOverSSH reverse-forwards a test
# control server's device listener with `ssh -O forward -R <socket there>:
# <socket here>` on an app-style master, then runs the real CherryMCP with a
# tab's test token against the forwarded socket (list_processes), checks
# that a missing or wrong token is refused, and that `-O cancel` and the
# cleanup take the socket away ("Cherry on Laptop is not reachable").
# Exits 2 when sshd cannot run here (then use Scripts/fake-remote-mac, which
# the Swift tests use).
set -euo pipefail

build=1
install=1
for argument in "$@"; do
  case "$argument" in
    --skip-build) build=0 ;;
    --no-install) install=0 ;;
    *) echo "Usage: Scripts/test-remote-mac-loopback [--skip-build] [--no-install]" >&2; exit 2 ;;
  esac
done
original_path=$PATH

root=$(cd "$(dirname "$0")/.." && pwd)
binaries=${CHERRY_FAKE_REMOTE_BIN:-${CARGO_TARGET_DIR:-$root/Host/target}/debug}
for tool in cherry cherry-host; do
  if [ ! -x "$binaries/$tool" ]; then
    echo "error: $binaries/$tool is missing; run Scripts/build-host debug" >&2
    exit 1
  fi
done
sshd=/usr/sbin/sshd
[ -x "$sshd" ] || { echo "sshd is not available here" >&2; exit 2; }

dir=$(mktemp -d "${TMPDIR:-/tmp}/ch-lb.XXXXXX")
dir=$(cd "$dir" && pwd -P)
chmod 700 "$dir"
mkdir -p "$dir/bin" "$dir/remote/home" "$dir/remote/bin"
chmod 700 "$dir/remote" "$dir/remote/home"
socket="$dir/remote/host.sock"
sshd_pid=

cleanup() {
  if [ -n "$sshd_pid" ]; then kill "$sshd_pid" 2>/dev/null || true; fi
  pkill -TERM -f "serve --socket $socket" 2>/dev/null || true
  sleep 0.2
  pkill -KILL -f "hold --socket $socket" 2>/dev/null || true
  pkill -KILL -f "serve --socket $socket" 2>/dev/null || true
  rm -rf "$dir"
}
trap cleanup EXIT

ln -s "$binaries/cherry-host" "$dir/remote/bin/cherry-host"
ln -s "$binaries/cherry" "$dir/remote/bin/cherry"

ssh-keygen -q -t ed25519 -N '' -f "$dir/host_key" -C cherry-loopback-host
ssh-keygen -q -t ed25519 -N '' -f "$dir/client_key" -C cherry-loopback-client
cp "$dir/client_key.pub" "$dir/authorized_keys"
chmod 600 "$dir/authorized_keys"

# Every command sshd runs goes through this, with the private environment;
# each is logged to $dir/commands.
cat > "$dir/force-command" <<EOF
#!/bin/sh
HOME='$dir/remote/home'
CHERRY_HOST_SOCKET='$socket'
PATH='$dir/remote/bin:/usr/bin:/bin:/usr/sbin:/sbin'
SHELL=/bin/sh
export HOME CHERRY_HOST_SOCKET PATH SHELL
printf '%s\n' "\$SSH_ORIGINAL_COMMAND" >> '$dir/commands'
case "\$SSH_ORIGINAL_COMMAND" in
  *gateway*)
    case "\$SSH_ORIGINAL_COMMAND" in
      *"--socket '$socket'"*) ;;
      *) echo "loopback: refusing a gateway without this script's --socket" >&2; exit 1 ;;
    esac ;;
esac
exec /bin/sh -c "\$SSH_ORIGINAL_COMMAND"
EOF
chmod 700 "$dir/force-command"

port=$((20000 + RANDOM % 20000))
cat > "$dir/sshd_config" <<EOF
ListenAddress 127.0.0.1
Port $port
HostKey $dir/host_key
PidFile $dir/sshd.pid
AuthorizedKeysFile $dir/authorized_keys
AllowUsers $(id -un)
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
StrictModes no
PermitTTY no
AllowAgentForwarding no
AllowTcpForwarding yes
PermitOpen localhost:* 127.0.0.1:* [::1]:*
PermitListen none
AllowStreamLocalForwarding yes
StreamLocalBindUnlink no
X11Forwarding no
PermitUserEnvironment no
MaxSessions 3
ForceCommand $dir/force-command
EOF

if ! "$sshd" -t -f "$dir/sshd_config" 2>"$dir/sshd-test.log"; then
  echo "sshd cannot run here without admin rights:" >&2
  cat "$dir/sshd-test.log" >&2
  exit 2
fi
"$sshd" -D -e -f "$dir/sshd_config" 2>"$dir/sshd.log" &
sshd_pid=$!

cat > "$dir/ssh_config" <<EOF
Host loopback
  HostName 127.0.0.1
  Port $port
  User $(id -un)
  IdentityFile $dir/client_key
  IdentitiesOnly yes
  IdentityAgent none
  UserKnownHostsFile $dir/known_hosts
  GlobalKnownHostsFile /dev/null
  StrictHostKeyChecking accept-new
  UpdateHostKeys no
  ControlMaster no
  ControlPath none
EOF
# The only ssh on PATH for everything below.
cat > "$dir/bin/ssh" <<EOF
#!/bin/sh
exec /usr/bin/ssh -F '$dir/ssh_config' "\$@"
EOF
chmod 700 "$dir/bin/ssh"
export PATH="$dir/bin:/usr/bin:/bin"

# Wait for sshd to answer.
for _ in $(seq 1 50); do
  if ssh -o BatchMode=yes -o ConnectTimeout=2 loopback true 2>/dev/null; then break; fi
  if ! kill -0 "$sshd_pid" 2>/dev/null; then
    echo "sshd did not start:" >&2
    cat "$dir/sshd.log" >&2
    exit 2
  fi
  sleep 0.1
done

fail() { echo "FAIL: $*" >&2; exit 1; }
pass() { echo "ok - $*"; }

ssh -o BatchMode=yes loopback true || fail "a BatchMode login"
pass "BatchMode login to 127.0.0.1:$port"

# The Add Mac check: sh -s with the script on standard input.
check=$(ssh -T -o BatchMode=yes -a -- loopback 'sh -s' <<EOF
printf 'home=%s\n' "\$HOME"
host=\$(command -v cherry-host)
printf 'hostpath=%s\n' "\$host"
printf 'version=%s\n' "\$("\$host" version --json | tr -d '\n')"
printf 'status=%s\n' "\$("\$host" status --json --socket "\$CHERRY_HOST_SOCKET" | tr -d '\n')"
EOF
)
printf '%s\n' "$check" | grep -q "^home=$dir/remote/home\$" || fail "the check ran with the private HOME: $check"
printf '%s\n' "$check" | grep -q '^version={"protocol":' || fail "cherry-host version --json: $check"
printf '%s\n' "$check" | grep -q '^status={"running":false' || fail "cherry-host status --json (no daemon yet): $check"
pass "the Add Mac check through sh -s"

cli() { "$binaries/cherry" --host loopback --socket "$socket" "$@"; }

session=$(cli new --cwd "~" --name loopback-test --owner "Cherry@00000000-0000-0000-0000-000000000000" \
  --tag cherry.project="device:00000000-0000-0000-0000-000000000000:$dir/remote/home" -- /bin/sh -c 'sleep 600')
id=$(printf '%s' "$session" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
[ -n "$id" ] || fail "cherry --host loopback new: $session"
cli list | grep -q "$id" || fail "the new session is listed"
pass "a session created and listed through cherry --host (gateway, private daemon)"

"$binaries/cherry" --host loopback --socket "$socket" --remote-host-path "$dir/remote/bin/cherry-host" list | grep -q "$id" \
  || fail "--remote-host-path"
pass "--remote-host-path"

cli kill "$id" >/dev/null || fail "cherry kill"
for _ in $(seq 1 50); do
  if ! cli list | grep "$id" | grep -q running; then break; fi
  sleep 0.1
done
cli remove "$id" >/dev/null 2>&1 || true
pass "the session ended"

if [ "$install" = 1 ]; then
  # Install & Add over this sshd: the app's installer, run by its Swift test.
  if [ "$build" = 1 ]; then
    (cd "$root" && PATH="$original_path" swift build --build-tests >"$dir/swift-build.log" 2>&1) \
      || { cat "$dir/swift-build.log" >&2; fail "swift build --build-tests"; }
  fi
  test_name=RemoteDeviceRealHostInstallRunsTheRealCopyOverSSH
  if ! (cd "$root" && env PATH="$original_path" CHERRY_TEST_HOST_INTEGRATION=1 \
    CHERRY_TEST_LOOPBACK_SSH="$dir/bin/ssh" CHERRY_TEST_LOOPBACK_HOME="$dir/remote/home" \
    CHERRY_TEST_LOOPBACK_DESTINATION=loopback \
    swift test --skip-build --no-parallel --filter "$test_name" >"$dir/swift-test.log" 2>&1); then
    cat "$dir/swift-test.log" >&2
    fail "the installer over SSH ($test_name)"
  fi
  grep -q "Test $test_name() passed" "$dir/swift-test.log" || { cat "$dir/swift-test.log" >&2; fail "$test_name did not run"; }
  grep -q "tar -xf - -C" "$dir/commands" || fail "the copy went over this sshd as a tar stream"
  installed=$(cd "$dir/remote/home/Library/Application Support/cherry-host/bin" && ls)
  [ "$(printf '%s\n' "$installed" | wc -l | tr -d ' ')" = 1 ] || fail "one build directory installed: $installed"
  codesign --verify --strict "$dir/remote/home/Library/Application Support/cherry-host/bin/$installed/cherry-host" \
    || fail "the installed cherry-host is signed"
  pass "Install & Add copied, checked and placed $installed over SSH (and skipped copying it again)"

  "$binaries/cherry" --host loopback --socket "$socket" \
    --remote-host-path "~/Library/Application Support/cherry-host/bin/$installed/cherry-host" list >/dev/null \
    || fail "cherry --host through the installed cherry-host"
  grep -F -q "'Library/Application Support/cherry-host/bin/$installed/cherry-host' gateway" "$dir/commands" \
    || fail "the gateway ran the installed cherry-host"
  pass "the installed cherry-host's gateway serves cherry --host"
fi

# SSH master shards against MaxSessions 3 (the app's manager, run by its
# Swift test against this sshd).
if [ "$build" = 1 ] && [ "$install" = 0 ]; then
  (cd "$root" && PATH="$original_path" swift build --build-tests >"$dir/swift-build.log" 2>&1) \
    || { cat "$dir/swift-build.log" >&2; fail "swift build --build-tests"; }
fi
shard_test=RemoteDeviceRealHostShardsSSHMastersAboveTheChannelCap
if ! (cd "$root" && env PATH="$original_path" CHERRY_TEST_HOST_INTEGRATION=1 \
  CHERRY_TEST_LOOPBACK_SSH="$dir/bin/ssh" CHERRY_TEST_LOOPBACK_DESTINATION=loopback \
  swift test --skip-build --no-parallel --filter "$shard_test" >"$dir/swift-shard.log" 2>&1); then
  cat "$dir/swift-shard.log" >&2
  fail "SSH master shards over SSH ($shard_test)"
fi
grep -q "Test $shard_test() passed" "$dir/swift-shard.log" || { cat "$dir/swift-shard.log" >&2; fail "$shard_test did not run"; }
pass "a second SSH master above MaxSessions 3 (the first refused a fourth session)"

# A port forwarded through an app-style SSH master (the app's
# RemotePortForwards, run by its Swift test against this sshd).
forward_test=RemoteDeviceRealHostForwardsAPortThroughTheSSHMaster
if ! (cd "$root" && env PATH="$original_path" CHERRY_TEST_HOST_INTEGRATION=1 \
  CHERRY_TEST_LOOPBACK_SSH="$dir/bin/ssh" CHERRY_TEST_LOOPBACK_DESTINATION=loopback \
  swift test --skip-build --no-parallel --filter "$forward_test" >"$dir/swift-forward.log" 2>&1); then
  cat "$dir/swift-forward.log" >&2
  fail "a port forwarded over SSH ($forward_test)"
fi
grep -q "Test $forward_test() passed" "$dir/swift-forward.log" || { cat "$dir/swift-forward.log" >&2; fail "$forward_test did not run"; }
pass "a page fetched through ssh -O forward on a master with ClearAllForwardings=yes, then cancelled"

# Cherry MCP through a reverse forward of a Unix socket (the app's
# RemoteMCPForwards and the real CherryMCP, run by their Swift test).
mcp_test=RemoteDeviceRealHostForwardsCherryMCPOverSSH
if ! (cd "$root" && env PATH="$original_path" CHERRY_TEST_HOST_INTEGRATION=1 \
  CHERRY_TEST_LOOPBACK_SSH="$dir/bin/ssh" CHERRY_TEST_LOOPBACK_DESTINATION=loopback \
  swift test --skip-build --no-parallel --filter "$mcp_test" >"$dir/swift-mcp.log" 2>&1); then
  cat "$dir/swift-mcp.log" >&2
  fail "Cherry MCP over a reverse forward ($mcp_test)"
fi
grep -q "Test $mcp_test() passed" "$dir/swift-mcp.log" || { cat "$dir/swift-mcp.log" >&2; fail "$mcp_test did not run"; }
pass "CherryMCP called list_processes through ssh -O forward -R of a Unix socket, refused without a valid token"

# The daemon it started is this script's private one.
pgrep -f "serve --socket $socket" >/dev/null || fail "a private daemon served $socket"
pass "only the private daemon at $socket was used"
echo "All loopback checks passed."
