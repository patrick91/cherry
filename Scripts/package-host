#!/usr/bin/env bash
# Build an archive of the helpers: universal on macOS (Scripts/build-host),
# native elsewhere. On Linux, run it on each supported architecture.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# Same resolution as Scripts/build-host, which receives the absolute path.
target_dir=${CARGO_TARGET_DIR:-${CARGO_BUILD_TARGET_DIR:-$root/Host/target}}
case "$target_dir" in /*) ;; *) target_dir="$PWD/$target_dir" ;; esac
export CARGO_TARGET_DIR="$target_dir"
"$root/Scripts/build-host" release
target=$(rustc -vV | sed -n 's/^host: //p')
# Scripts/build-host builds universal executables on macOS.
case "$target" in
  *-apple-darwin)
    if "$root/Scripts/check-helper-archs" "$target_dir/release/cherry" "$target_dir/release/cherry-host" 2>/dev/null; then
      target=universal-apple-darwin
    fi
    ;;
esac
output="$root/dist/host"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir -p "$output" "$stage/cherry-host"
cp "$target_dir/release/cherry" "$target_dir/release/cherry-host" "$stage/cherry-host/"
cp "$root/Host/README.md" "$stage/cherry-host/README.md"
cp -R "$root/Host/packaging" "$stage/cherry-host/packaging"
mkdir -p "$stage/cherry-host/vendor/ghostty-vt" "$stage/cherry-host/crates/cherry-vt"
cp "$root/Host/vendor/ghostty-vt/README.md" "$stage/cherry-host/vendor/ghostty-vt/README.md"
cp "$root/Host/crates/cherry-vt/README.md" "$stage/cherry-host/crates/cherry-vt/README.md"
cp "$root/Host/THIRD_PARTY_NOTICES.txt" "$stage/cherry-host/THIRD_PARTY_NOTICES.txt"
mkdir -p "$stage/cherry-host/licenses"
cp "$root/Host/vendor/ghostty-vt/LICENSE" "$stage/cherry-host/licenses/Ghostty-LICENSE"
cp "$root/Host/vendor/ghostty-vt/THIRD_PARTY_NOTICES.txt" "$stage/cherry-host/licenses/Ghostty-THIRD_PARTY_NOTICES.txt"
tar -czf "$output/cherry-host-$target.tar.gz" -C "$stage" cherry-host
printf '%s\n' "$output/cherry-host-$target.tar.gz"
