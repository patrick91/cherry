#!/usr/bin/env bash
# Build the standalone, dependency-free sidebar design playground.
set -euo pipefail
repo_root=$(cd "$(dirname "$0")/.." && pwd)
package_root="$repo_root/Design/SidebarPlayground"
configuration=${CHERRY_PLAYGROUND_CONFIGURATION:-release}
app_name='Cherry Sidebar Playground'
output_root="$repo_root/dist"
stage_root=$(mktemp -d "${TMPDIR:-/tmp}/cherry-playground.XXXXXX")
trap 'rm -rf "$stage_root"' EXIT

swift build --package-path "$package_root" -c "$configuration" --product SidebarPlayground
bin_dir=$(swift build --package-path "$package_root" -c "$configuration" --show-bin-path)
app_path="$stage_root/$app_name.app"
mkdir -p "$app_path/Contents/MacOS" "$app_path/Contents/Resources" "$output_root"
cp "$bin_dir/SidebarPlayground" "$app_path/Contents/MacOS/SidebarPlayground"
cp -R "$bin_dir/CherrySidebarPlayground_SidebarPlayground.bundle" "$app_path/Contents/Resources/"
cp "$repo_root/Design/SessionsIcon/AppIconSessions.icns" "$app_path/Contents/Resources/AppIcon.icns"
cat > "$app_path/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>$app_name</string>
<key>CFBundleDisplayName</key><string>$app_name</string>
<key>CFBundleExecutable</key><string>SidebarPlayground</string>
<key>CFBundleIdentifier</key><string>dev.patrick.cherry.sidebar-playground</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>$(date +%Y%m%d%H%M%S)</string>
<key>CFBundleShortVersionString</key><string>0.1</string>
<key>CFBundleIconFile</key><string>AppIcon.icns</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>NSHighResolutionCapable</key><true/>
<key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
</dict></plist>
PLIST
plutil -lint "$app_path/Contents/Info.plist"
codesign --force --deep --sign - "$app_path"
codesign --verify --deep --strict "$app_path"
# Only replace this script's dedicated output app, never an installed Cherry app.
rm -rf "$output_root/$app_name.app"
ditto "$app_path" "$output_root/$app_name.app"
cp "$package_root/README.md" "$stage_root/Read me.txt"
ln -s /Applications "$stage_root/Applications"
if [[ "${1:-}" != '--app-only' ]]; then
    disk_image="$output_root/$app_name-$(uname -m).dmg"
    hdiutil create -fs HFS+ -volname "$app_name" -srcfolder "$stage_root" -format UDZO -ov "$disk_image"
    hdiutil verify "$disk_image"
    shasum -a 256 "$disk_image" > "$disk_image.sha256"
    printf 'Disk image: %s\n' "$disk_image"
fi
printf 'App: %s\n' "$output_root/$app_name.app"
