#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIGURATION="${CHERRY_CONFIGURATION:-release}"
APP_NAME="${CHERRY_APP_NAME:-Cherry}"
BUNDLE_ID="${CHERRY_BUNDLE_ID:-dev.patrick.cherry.local}"
INSTALL_DIR="${CHERRY_INSTALL_DIR:-$HOME/Applications}"
CODE_SIGN_IDENTITY="${CHERRY_CODESIGN_IDENTITY:--}"
BUILD_DIR="$ROOT/.build/install"
APP_PATH="$BUILD_DIR/$APP_NAME.app"
INSTALL_PATH="$INSTALL_DIR/$APP_NAME.app"
ICON_SOURCE="$ROOT/Sources/Cherry/Resources/AppIcon.icon"
ICON_FALLBACK="$ROOT/Sources/Cherry/Resources/AppIcon.icns"
ICON_INFO_PLIST="$BUILD_DIR/assetcatalog_generated_info.plist"

cd "$ROOT"

# Live-surface keep-warm: ON by default for installed dogfood builds, so the
# installed .app keeps recently-used Ghostty surfaces alive across tab switches
# instead of freeing + replaying them. Opt out (old replay-on-switch behavior)
# with CHERRY_KEEP_SURFACES_WARM=0 Scripts/install-local-app.
# (EXTRA_BUILD_ARGS is a plain string, not a bash array, so empty expansion is
# safe under `set -u` on macOS's stock bash 3.2; these flags contain no spaces.)
KEEP_WARM="${CHERRY_KEEP_SURFACES_WARM:-1}"
EXTRA_BUILD_ARGS=""
if [[ "$KEEP_WARM" != "0" ]]; then
  EXTRA_BUILD_ARGS="-Xswiftc -DCHERRY_KEEP_SURFACES_WARM"
  echo "Building WARM (live surfaces kept warm; opt out with CHERRY_KEEP_SURFACES_WARM=0)"
else
  echo "Building STOCK (replay-on-switch; the old behavior)"
fi

swift build -c "$CONFIGURATION" --product Cherry $EXTRA_BUILD_ARGS
swift build -c "$CONFIGURATION" --product CherryMCP

BIN_DIR="$(swift build -c "$CONFIGURATION" --show-bin-path)"
BINARY_PATH="$BIN_DIR/Cherry"
MCP_HELPER_PATH="$BIN_DIR/CherryMCP"
GIT_REVISION="$(git rev-parse --short HEAD 2>/dev/null || echo local)"
BUILD_NUMBER="$(date +%Y%m%d%H%M%S)"

rm -rf "$APP_PATH"
mkdir -p "$APP_PATH/Contents/MacOS" "$APP_PATH/Contents/Resources"
cp "$BINARY_PATH" "$APP_PATH/Contents/MacOS/Cherry"
cp "$MCP_HELPER_PATH" "$APP_PATH/Contents/MacOS/CherryMCP"

if [[ -d "$ICON_SOURCE" ]] && xcrun --find actool >/dev/null 2>&1; then
  if xcrun actool "$ICON_SOURCE" \
    --compile "$APP_PATH/Contents/Resources" \
    --output-format human-readable-text \
    --notices \
    --warnings \
    --output-partial-info-plist "$ICON_INFO_PLIST" \
    --app-icon AppIcon \
    --standalone-icon-behavior all \
    --include-all-app-icons \
    --compress-pngs \
    --development-region en \
    --target-device mac \
    --minimum-deployment-target 26.0 \
    --platform macosx \
    --bundle-identifier "$BUNDLE_ID" >/dev/null; then
    :
  else
    echo "warning: failed to compile AppIcon.icon with actool; using AppIcon.icns fallback" >&2
    cp "$ICON_FALLBACK" "$APP_PATH/Contents/Resources/AppIcon.icns"
  fi
else
  cp "$ICON_FALLBACK" "$APP_PATH/Contents/Resources/AppIcon.icns"
fi

cat > "$APP_PATH/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>$APP_NAME</string>
  <key>CFBundleExecutable</key>
  <string>Cherry</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>CFBundleIdentifier</key>
  <string>$BUNDLE_ID</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$APP_NAME</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0-local</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>$BUNDLE_ID.deep-link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>cherry</string>
      </array>
    </dict>
  </array>
  <key>CFBundleVersion</key>
  <string>$BUILD_NUMBER.$GIT_REVISION</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>26.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticTermination</key>
  <false/>
  <key>NSSupportsSuddenTermination</key>
  <false/>
</dict>
</plist>
PLIST

if command -v codesign >/dev/null 2>&1; then
  codesign --force --deep --sign "$CODE_SIGN_IDENTITY" "$APP_PATH" >/dev/null
fi

mkdir -p "$INSTALL_DIR"
rm -rf "$INSTALL_PATH"
ditto "$APP_PATH" "$INSTALL_PATH"

if command -v xattr >/dev/null 2>&1; then
  xattr -dr com.apple.quarantine "$INSTALL_PATH" 2>/dev/null || true
fi

echo "Installed $INSTALL_PATH"
echo "Open it with: open '$INSTALL_PATH'"
