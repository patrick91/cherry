#!/usr/bin/env python3
"""Create a review bundle with provisional labels on useful transition frames."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import socket
import sys
import tempfile
import uuid
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterator


BUNDLE_SCHEMA_VERSION = 1
OBSERVATION_SCHEMA_VERSION = 1
REVIEW_EPISODE_WINDOW_SECONDS = 5

ATTENTION_NEEDED = "attention_needed"
NO_ATTENTION_NEEDED = "no_attention_needed"
USER_COMPOSING_RATIONALE = "user_composing_at_prompt"

RESULT_MARKERS = (
    "worked for",
    "baked for",
    "cooked for",
    "cogitated for",
    "crunched for",
    "churned for",
    "sautéed for",
    "sauteed for",
    "brewed for",
)

APPROVAL_MARKERS = (
    "do you want to proceed",
    "would you like to proceed",
    "waiting for approval",
    "press enter to approve",
    "approve this action",
    "allow this command",
    "allow command",
    "allow computer use to use",
    "run the tool and continue",
)

BLOCKED_MARKERS = (
    "process exited",
    "fatal error",
    "panic:",
)

USER_INTERRUPTION_MARKERS = (
    "conversation interrupted",
    "task interrupted",
)


class ProvisionalLabelError(Exception):
    pass


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def observation_lines(path: Path) -> Iterator[dict[str, Any]]:
    with path.open("r", encoding="utf-8") as handle:
        for line_number, line in enumerate(handle, start=1):
            if not line.strip():
                continue
            try:
                observation = json.loads(line)
            except json.JSONDecodeError as error:
                raise ProvisionalLabelError(f"{path}:{line_number}: invalid JSON: {error}") from error
            if not isinstance(observation, dict):
                raise ProvisionalLabelError(f"{path}:{line_number}: observation must be an object")
            if observation.get("schemaVersion") != OBSERVATION_SCHEMA_VERSION:
                raise ProvisionalLabelError(
                    f"{path}:{line_number}: unsupported observation schema "
                    f"{observation.get('schemaVersion')!r}"
                )
            if not isinstance(observation.get("id"), str):
                raise ProvisionalLabelError(f"{path}:{line_number}: missing observation id")
            yield observation


def terminal_text(observation: dict[str, Any]) -> str:
    terminal = observation.get("terminal")
    if not isinstance(terminal, dict):
        return ""
    grid = terminal.get("grid")
    if not isinstance(grid, list):
        return ""
    lines = [line for line in grid if isinstance(line, str)]
    return "\n".join(lines[-48:]).casefold()


def interaction_value(observation: dict[str, Any], key: str) -> bool | None:
    interaction = observation.get("interaction")
    if not isinstance(interaction, dict):
        return None
    value = interaction.get(key)
    return value if isinstance(value, bool) else None


def session_id(observation: dict[str, Any]) -> str:
    session = observation.get("session")
    if not isinstance(session, dict):
        return ""
    value = session.get("id")
    return value if isinstance(value, str) else ""


def activity_state(observation: dict[str, Any]) -> str:
    activity = observation.get("activity")
    if not isinstance(activity, dict):
        return ""
    value = activity.get("state")
    return value if isinstance(value, str) else ""


def attention_annotation(
    reason: str,
    rationale: str,
    confidence: float,
) -> tuple[str, dict[str, Any]]:
    return ATTENTION_NEEDED, {
        "schemaVersion": 1,
        "provenance": "codex_transition_review",
        "confidence": confidence,
        "rationale": rationale,
        "reason": reason,
    }


def no_attention_annotation(
    reason: str,
    rationale: str,
    confidence: float = 0.99,
) -> tuple[str, dict[str, Any]]:
    return NO_ATTENTION_NEEDED, {
        "schemaVersion": 1,
        "provenance": "codex_transition_review",
        "confidence": confidence,
        "rationale": rationale,
        "reason": reason,
    }


def working_annotation() -> tuple[str, dict[str, Any]]:
    return no_attention_annotation("agent_working", "active_working_indicator")


def user_composing_annotation() -> tuple[str, dict[str, Any]]:
    return no_attention_annotation("user_responding", USER_COMPOSING_RATIONALE)


def classify_idle(
    observation: dict[str, Any],
) -> tuple[str, dict[str, Any]] | None:
    text = terminal_text(observation)
    if interaction_value(observation, "hasUnsubmittedInput") is True:
        return user_composing_annotation()
    if any(marker in text for marker in USER_INTERRUPTION_MARKERS):
        # An interrupted turn is user-initiated in supported Codex flows. It is
        # not an agent failure, but a viewport alone cannot establish whether
        # the user still expects a notification, so leave it for human review.
        return None
    if any(marker in text for marker in APPROVAL_MARKERS):
        return attention_annotation("waiting_for_approval", "approval_prompt_visible", 0.99)
    if any(marker in text for marker in BLOCKED_MARKERS):
        return attention_annotation("blocked_or_error", "blocked_or_error_visible", 0.97)
    if any(marker in text for marker in RESULT_MARKERS):
        return attention_annotation("result_ready", "completed_turn_at_prompt", 0.98)
    return attention_annotation("waiting_for_input", "waiting_at_prompt", 0.94)


def classify_notification(
    observation: dict[str, Any],
) -> tuple[str, dict[str, Any]] | None:
    state = activity_state(observation)
    if state == "idle":
        return classify_idle(observation)

    text = terminal_text(observation)
    if interaction_value(observation, "hasUnsubmittedInput") is True:
        return user_composing_annotation()
    if any(marker in text for marker in USER_INTERRUPTION_MARKERS):
        return None
    if state == "permission" or any(marker in text for marker in APPROVAL_MARKERS):
        return attention_annotation("waiting_for_approval", "approval_prompt_visible", 0.99)
    if any(marker in text for marker in BLOCKED_MARKERS):
        return attention_annotation("blocked_or_error", "blocked_or_error_visible", 0.97)
    if any(marker in text for marker in RESULT_MARKERS):
        # Notification observations can be captured before the harness activity
        # state changes from working to idle, so the terminal completion marker
        # is stronger evidence than the stale state.
        return attention_annotation("result_ready", "completed_turn_at_prompt", 0.98)
    return working_annotation()


def provisional_label(
    observation: dict[str, Any],
    next_observation: dict[str, Any] | None,
) -> tuple[str, dict[str, Any]] | None:
    if observation.get("label") is not None:
        return None

    event = observation.get("event")
    state = activity_state(observation)

    if event == "process_exited":
        return attention_annotation("blocked_or_error", "blocked_or_error_visible", 0.99)

    if event == "input_submitted":
        return working_annotation()

    if event == "activity_state_changed":
        if interaction_value(observation, "hasUnsubmittedInput") is True:
            return user_composing_annotation()
        return classify_idle(observation) if state == "idle" else working_annotation()

    if event == "notification":
        return classify_notification(observation)

    if (
        event == "input_changed"
        and state == "idle"
        and interaction_value(observation, "hasUnsubmittedInput") is True
        and interaction_value(observation, "terminalFocused") is False
    ):
        return user_composing_annotation()

    if (
        next_observation is not None
        and next_observation.get("event") == "input_submitted"
        and state == "idle"
        and interaction_value(observation, "hasUnsubmittedInput") is True
    ):
        return user_composing_annotation()

    return None


def recorded_at(observation: dict[str, Any]) -> datetime | None:
    value = observation.get("recordedAt")
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def same_review_episode(
    earlier: dict[str, Any],
    earlier_label: tuple[str, dict[str, Any]] | None,
    later: dict[str, Any],
    later_label: tuple[str, dict[str, Any]] | None,
) -> bool:
    if earlier_label is None or later_label is None:
        return False
    if session_id(earlier) == "" or session_id(earlier) != session_id(later):
        return False

    earlier_time = recorded_at(earlier)
    later_time = recorded_at(later)
    if earlier_time is None or later_time is None:
        return False
    elapsed = (later_time - earlier_time).total_seconds()
    if elapsed < 0 or elapsed > REVIEW_EPISODE_WINDOW_SECONDS:
        return False

    earlier_name, earlier_annotation = earlier_label
    later_name, later_annotation = later_label
    signature = (
        earlier_name,
        earlier_annotation.get("reason"),
        earlier_annotation.get("rationale"),
    )
    later_signature = (
        later_name,
        later_annotation.get("reason"),
        later_annotation.get("rationale"),
    )
    if signature != later_signature:
        return False

    # While a draft is present, working/idle changes are implementation noise:
    # they describe one continuous user-composition episode even if startup
    # messages alter the visible terminal grid.
    if earlier_annotation.get("rationale") == USER_COMPOSING_RATIONALE:
        return True
    return terminal_text(earlier) == terminal_text(later)


def write_observations(
    source: Path,
    destination: Path,
) -> tuple[int, Counter[str], Counter[str], set[str], set[str]]:
    count = 0
    labels: Counter[str] = Counter()
    reasons: Counter[str] = Counter()
    sessions: set[str] = set()
    harnesses: set[str] = set()
    iterator = iter(observation_lines(source))
    current = next(iterator, None)

    def write(
        output: Any,
        observation: dict[str, Any],
        provisional: tuple[str, dict[str, Any]] | None,
    ) -> None:
        nonlocal count
        if provisional is not None:
            label, annotation = provisional
            observation["label"] = label
            observation["annotation"] = annotation
            labels[label] += 1
            reason = annotation.get("reason")
            if isinstance(reason, str):
                reasons[reason] += 1

        session = observation.get("session")
        if isinstance(session, dict):
            observation_session_id = session.get("id")
            harness = session.get("harness")
            if isinstance(observation_session_id, str) and observation_session_id:
                sessions.add(observation_session_id)
            if isinstance(harness, str) and harness:
                harnesses.add(harness)

        output.write(json.dumps(observation, separators=(",", ":"), sort_keys=True))
        output.write("\n")
        count += 1

    review_window: list[
        tuple[dict[str, Any], tuple[str, dict[str, Any]] | None]
    ] = []
    with destination.open("w", encoding="utf-8") as output:
        while current is not None:
            next_observation = next(iterator, None)
            provisional = provisional_label(current, next_observation)

            if provisional is not None:
                for index in range(len(review_window) - 1, -1, -1):
                    earlier, earlier_label = review_window[index]
                    if same_review_episode(earlier, earlier_label, current, provisional):
                        review_window[index] = (earlier, None)
                        break
            review_window.append((current, provisional))

            current_time = recorded_at(current)
            while review_window:
                earliest, earliest_label = review_window[0]
                earliest_time = recorded_at(earliest)
                outside_window = (
                    current_time is not None
                    and earliest_time is not None
                    and (current_time - earliest_time).total_seconds()
                    > REVIEW_EPISODE_WINDOW_SECONDS
                )
                different_session = session_id(earliest) != session_id(current)
                if not outside_window and not different_session and len(review_window) <= 256:
                    break
                write(output, earliest, earliest_label)
                review_window.pop(0)

            current = next_observation

        for pending, pending_label in review_window:
            write(output, pending, pending_label)

    os.chmod(destination, 0o600)
    return count, labels, reasons, sessions, harnesses


def build_bundle(args: argparse.Namespace) -> None:
    sources = [path.expanduser().resolve() for path in args.trace]
    for source in sources:
        if not source.is_file() or source.is_symlink() or source.suffix != ".jsonl":
            raise ProvisionalLabelError(f"not a regular JSONL trace: {source}")

    output = args.output.expanduser().resolve()
    if output.exists():
        raise ProvisionalLabelError(f"output already exists: {output}")
    output.parent.mkdir(parents=True, exist_ok=True)

    temporary = Path(tempfile.mkdtemp(prefix=f".{output.name}-", dir=output.parent))
    os.chmod(temporary, 0o700)
    observations_directory = temporary / "observations"
    observations_directory.mkdir(mode=0o700)

    entries: list[dict[str, Any]] = []
    total_labels: Counter[str] = Counter()
    total_reasons: Counter[str] = Counter()
    try:
        for source in sources:
            destination = observations_directory / source.name
            count, labels, reasons, sessions, harnesses = write_observations(source, destination)
            total_labels.update(labels)
            total_reasons.update(reasons)
            entries.append({
                "relativePath": f"observations/{source.name}",
                "sha256": sha256_file(destination),
                "bytes": destination.stat().st_size,
                "observationCount": count,
                "labeledCount": sum(labels.values()),
                "labels": dict(sorted(labels.items())),
                "reasons": dict(sorted(reasons.items())),
                "sessionIDs": sorted(sessions),
                "harnesses": sorted(harnesses),
            })

        manifest = {
            "bundleSchemaVersion": BUNDLE_SCHEMA_VERSION,
            "observationSchemaVersion": OBSERVATION_SCHEMA_VERSION,
            "bundleID": str(uuid.uuid4()),
            "createdAt": utc_now(),
            "sourceHost": args.source_host or socket.gethostname(),
            "files": entries,
            "totals": {
                "files": len(entries),
                "bytes": sum(entry["bytes"] for entry in entries),
                "observations": sum(entry["observationCount"] for entry in entries),
                "labeled": sum(entry["labeledCount"] for entry in entries),
            },
            "provisionalLabels": dict(sorted(total_labels.items())),
            "provisionalReasons": dict(sorted(total_reasons.items())),
        }
        manifest_path = temporary / "manifest.json"
        manifest_path.write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        os.chmod(manifest_path, 0o600)
        os.replace(temporary, output)
    except Exception:
        # Leave the private temporary directory in place for diagnosis rather
        # than risking deletion of a caller-supplied path.
        raise

    print(f"Created {output}")
    print(f"Observations: {manifest['totals']['observations']}")
    print(f"Provisional labels: {manifest['totals']['labeled']}")
    print("Labels: " + ", ".join(f"{key}={value}" for key, value in sorted(total_labels.items())))
    print("Reasons: " + ", ".join(f"{key}={value}" for key, value in sorted(total_reasons.items())))


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("trace", type=Path, nargs="+", help="Raw Cherry JSONL trace files.")
    parser.add_argument("--output", type=Path, required=True, help="New review bundle directory.")
    parser.add_argument("--source-host", help="Human-readable source machine name for the dashboard.")
    return parser.parse_args()


def main() -> int:
    try:
        build_bundle(parse_args())
        return 0
    except (OSError, ProvisionalLabelError) as error:
        print(f"attention-provisional-labels: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
