---
import "@fontsource-variable/inter";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scheme-only-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A private dashboard for inspecting Cherry terminal-attention observations."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Cherry Attention Lab</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Homepage">
          <span class="brand-mark" aria-hidden="true">C</span>
          <span>Attention Lab</span>
        </a>
        <div class="connection-state" id="connection-state">Locked</div>
      </header>

      <main class="app" id="app">
        <section class="login-view" id="login-view" aria-labelledby="login-title">
          <div class="login-copy">
            <p class="kicker">Private dataset viewer</p>
            <h1 id="login-title">See what Cherry captured.</h1>
            <p>
              Enter the dashboard token configured in Cloudflare. It stays in this browser tab and
              is sent only to this Worker.
            </p>
          </div>
          <form class="login-form" id="login-form">
            <label for="token">Dashboard token</label>
            <input
              id="token"
              name="token"
              type="password"
              autocomplete="current-password"
              required
            />
            <button class="button button-primary button-large" type="submit">Open dashboard</button>
            <p class="form-message" id="login-message" aria-live="polite"></p>
          </form>
        </section>

        <div class="dashboard" id="dashboard" hidden>
          <section class="page-intro">
            <div>
              <p class="kicker">Terminal attention study</p>
              <h1>Review attention labels.</h1>
              <p>
                Understand what Cherry thinks needs your attention, why it chose that label, and
                what was visible in the terminal.
              </p>
            </div>
            <button class="button button-ghost" id="change-token" type="button">Change token</button>
          </section>

          <section class="stats-section" aria-label="Dataset summary">
            <div class="stats-grid">
              <div class="stat">
                <span>Observations</span>
                <strong id="stat-observations">0</strong>
              </div>
              <div class="stat">
                <span>Labeled</span>
                <strong id="stat-labeled">0</strong>
              </div>
              <div class="stat">
                <span>Sessions</span>
                <strong id="stat-sessions">0</strong>
              </div>
              <div class="stat">
                <span>Bundles</span>
                <strong id="stat-bundles">0</strong>
              </div>
            </div>
          </section>

          <section class="observations-section" aria-labelledby="observations-title">
            <div class="section-heading observation-heading">
              <div>
                <h2 id="observations-title">Label review.</h2>
                <p>Review one observation at a time, with its decision and terminal context.</p>
              </div>
              <div class="filters">
                <label>
                  <span>Label</span>
                  <select id="label-filter" name="label">
                    <option value="">All labels</option>
                    <option value="labeled" selected>All provisional labels</option>
                    <option value="unlabeled">Unlabeled</option>
                    <option value="approval_required">Approval required</option>
                    <option value="waiting_for_input">Waiting for input</option>
                    <option value="ready_for_review">Ready for review</option>
                    <option value="no_attention_needed">No attention needed</option>
                    <option value="unknown">Unknown</option>
                  </select>
                </label>
                <label>
                  <span>Harness</span>
                  <select id="harness-filter" name="harness">
                    <option value="">All harnesses</option>
                  </select>
                </label>
              </div>
            </div>

            <div class="label-context" id="label-context">
              <div>
                <span class="label-context-name" id="label-context-name">All observations</span>
                <span class="label-context-count" id="label-context-count">0 results</span>
              </div>
              <p id="label-context-description">
                Browse every stored observation, including examples that have not been labeled yet.
              </p>
            </div>

            <div class="review-workspace">
              <nav class="review-navigation" id="review-navigation" aria-label="Observation navigation">
                <div>
                  <span>Review queue</span>
                  <strong id="page-status" aria-live="polite">No observations</strong>
                </div>
                <div class="review-navigation-actions">
                  <button class="button button-ghost" id="previous-page" type="button" disabled>
                    Previous
                  </button>
                  <button class="button button-ghost" id="next-page" type="button" disabled>
                    Next
                  </button>
                </div>
              </nav>

              <article class="review-detail" id="review-detail" aria-live="polite">
                <div class="review-detail-empty" id="review-detail-empty">
                  <p class="kicker">Observation detail</p>
                  <h3>No observations found.</h3>
                  <p>Choose another label or harness filter to continue reviewing.</p>
                </div>

                <div class="review-detail-content" id="review-detail-content" hidden>
                  <header class="review-detail-header">
                    <div>
                      <div class="detail-label-line">
                        <span class="label-badge" id="detail-label">Unlabeled</span>
                        <span class="detail-harness" id="detail-harness">Unknown harness</span>
                      </div>
                      <h3 id="detail-heading">Observation detail.</h3>
                      <time id="detail-time"></time>
                    </div>
                  </header>

                  <section class="decision-summary" aria-labelledby="decision-title">
                    <div>
                      <p class="detail-eyebrow" id="decision-title">Why this label</p>
                      <p class="decision-rationale" id="detail-rationale">
                        No labeling rationale was recorded.
                      </p>
                      <p class="decision-description" id="detail-label-description"></p>
                    </div>
                    <div class="confidence" id="detail-confidence">
                      <div>
                        <span>Confidence</span>
                        <strong id="detail-confidence-value">Not recorded</strong>
                      </div>
                      <div
                        class="confidence-track"
                        role="progressbar"
                        aria-label="Label confidence"
                        aria-valuemin="0"
                        aria-valuemax="100"
                        id="detail-confidence-track"
                      >
                        <span id="detail-confidence-bar"></span>
                      </div>
                    </div>
                  </section>

                  <section class="interaction-summary" id="interaction-summary" hidden>
                    <div>
                      <p class="detail-eyebrow">User state</p>
                      <p class="interaction-title" id="detail-interaction-title">
                        No interaction data was captured.
                      </p>
                    </div>
                    <p class="interaction-description" id="detail-interaction-description"></p>
                  </section>

                  <dl class="observation-facts">
                    <div>
                      <dt>Event</dt>
                      <dd id="detail-event">Unknown</dd>
                    </div>
                    <div>
                      <dt>Activity</dt>
                      <dd id="detail-activity">Unknown</dd>
                    </div>
                    <div>
                      <dt>Evidence</dt>
                      <dd id="detail-evidence">Unknown</dd>
                    </div>
                    <div>
                      <dt>Session</dt>
                      <dd id="detail-session">Unknown</dd>
                    </div>
                  </dl>

                  <section class="terminal-detail" aria-labelledby="terminal-title">
                    <div class="terminal-heading">
                      <div>
                        <p class="detail-eyebrow">Captured context</p>
                        <h4 id="terminal-title">Terminal snapshot</h4>
                      </div>
                      <div class="terminal-capture-meta">
                        <span id="terminal-render-mode">Plain text</span>
                        <span aria-hidden="true">·</span>
                        <span id="terminal-size"></span>
                      </div>
                    </div>
                    <pre id="detail-terminal"></pre>
                  </section>

                  <details class="raw-payload">
                    <summary>Raw observation JSON</summary>
                    <pre id="detail-payload"></pre>
                  </details>
                </div>
              </article>
            </div>
          </section>

          <details class="dataset-tools">
            <summary>
              <span>
                <strong>Dataset tools</strong>
                <span>Import another bundle or inspect import history.</span>
              </span>
              <span class="dataset-tools-count" id="dataset-tools-count">0 bundles</span>
            </summary>
            <div class="dataset-tools-content">
              <section class="upload-section" aria-labelledby="upload-title">
                <div class="section-heading">
                  <div>
                    <h2 id="upload-title">Import a bundle.</h2>
                    <p>Select the directory created by <code>attention-study-data export</code>.</p>
                  </div>
                  <span class="privacy-badge">Terminal text included</span>
                </div>
                <div class="upload-well">
                  <label class="file-picker" for="bundle-input">Choose bundle directory</label>
                  <input
                    id="bundle-input"
                    name="bundle"
                    type="file"
                    multiple
                  />
                  <div class="upload-copy">
                    <strong id="selected-bundle">No bundle selected</strong>
                    <span id="selected-detail">Manifest and JSONL files remain unchanged locally.</span>
                  </div>
                  <button class="button button-primary" id="upload-button" type="button" disabled>
                    Import observations
                  </button>
                </div>
                <p class="upload-status" id="upload-status" aria-live="polite"></p>
              </section>

              <section class="bundles-section" aria-labelledby="bundles-title">
                <div class="section-heading">
                  <div>
                    <h2 id="bundles-title">Imported bundles.</h2>
                    <p>Expected and received counts make interrupted uploads visible.</p>
                  </div>
                </div>
                <div class="table-scroll">
                  <div class="table-inner">
                    <table>
                      <thead>
                        <tr>
                          <th>Imported</th>
                          <th>Source</th>
                          <th>Bundle</th>
                          <th class="number-column">Received</th>
                        </tr>
                      </thead>
                      <tbody id="bundle-rows"></tbody>
                    </table>
                  </div>
                </div>
              </section>
            </div>
          </details>
        </div>
      </main>
    </div>

    <script>
      import "../scripts/dashboard";
    </script>
  </body>
</html>
