#!/usr/bin/env python3
"""
Regression test: the MCP control server must stay responsive while service detection
(ps/lsof) runs.

Background: CherryControlServer is a single @MainActor. Service detection
(get_process_ports / list_services / wait_for_bound_port) used to spawn ps+lsof
SYNCHRONOUSLY on that actor, pinning it — so under nested-agent load other MCP requests
stalled, missed their client timeout, and the stdio transport was torn down
("Transport closed"). Fixed by running ps/lsof off the actor (Task.detached) + a watchdog.

Proof: hold a wait_for_bound_port on a port that never binds (it loops ps/lsof every
~150ms for ~3.5s) on one connection, and hammer list_processes on others. They must stay
fast (a pinned actor would stall them and let far fewer through).

Usage: Scripts/test-mcp-concurrency

Builds Cherry (release) and runs it apart from the user's own Cherry: a private
HOME (saved workspaces, notes, todos), and its control socket and session-host
socket (CHERRY_CONTROL_SOCKET, CHERRY_HOST_SOCKET) in a private (0700)
directory. Local tabs are persistent sessions by default, so the test's tabs run
on a daemon of its own, never the user's. At the end every session there is
killed and removed, the daemon is shut down and the directory is deleted.
Preferences are the unbundled executable's own defaults domain ("Cherry"), which
the installed app does not use.
"""
import json, os, signal, socket, subprocess, sys, threading, time
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import cherry_private_host  # noqa: E402

REPO = Path(__file__).resolve().parent.parent
# Private (0700), with the private HOME in it, and short enough for Unix
# socket paths.
PRIVATE = cherry_private_host.make_private_directory("cherry-mcp-")
HOME, SOCK, HOST_SOCK = cherry_private_host.layout(PRIVATE)
LOG = Path("/tmp/mcp-conc.log")

def ec(n, p=None): return {n: {"_0": p} if p is not None else {}}
def sc(r): return ec("scoped", {"projectRoot": str(REPO), "request": r})

def send(req, t=30):
    """Returns (result, elapsed_seconds). Raises RuntimeError on a control error."""
    d = json.dumps(req, separators=(",", ":")).encode() + b"\n"
    start = time.monotonic()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(t); s.connect(str(SOCK)); s.sendall(d); s.shutdown(socket.SHUT_WR)
        b = bytearray()
        while True:
            c = s.recv(65536)
            if not c: break
            b.extend(c)
            if b.endswith(b"\n"): break
    elapsed = time.monotonic() - start
    r = json.loads(b.decode())
    if r.get("error"): raise RuntimeError(r["error"])
    return r["result"], elapsed

def lp():
    _, e = send(sc(ec("listProcesses", {})), t=20)
    return e

# Without a Cherry tab's own variables (its control socket, process id), which
# would point at the user's app; the helper override stays.
env = cherry_private_host.isolated_environment(os.environ, HOME, SOCK, HOST_SOCK)
env["CHERRY_PERF_PROJECT_ROOTS"] = str(REPO)
proc = None
results = {}
try:
    # Built with the user's own HOME, where SwiftPM keeps its caches.
    subprocess.run(["swift", "build", "-c", "release", "--product", "Cherry"], cwd=str(REPO), check=True)
    bin_path = subprocess.run(["swift", "build", "-c", "release", "--show-bin-path"], cwd=str(REPO),
                              check=True, capture_output=True, text=True).stdout.strip()
    proc = subprocess.Popen([str(Path(bin_path) / "Cherry")], cwd=str(REPO),
                            env=env, stdout=open(LOG, "w"), stderr=subprocess.STDOUT)
    dl = time.monotonic() + 180
    while time.monotonic() < dl:
        if proc.poll() is not None: raise RuntimeError(f"Cherry exited early; see {LOG}")
        if SOCK.exists():
            try: send(ec("listProjects"), 3); break
            except Exception: pass
        time.sleep(0.3)
    send(ec("openProject", {"projectRoot": str(REPO)}), 30); time.sleep(1.0)
    for i in range(2):
        send(sc(ec("spawnProcess", {"kind": "terminal", "title": f"t{i}", "workingDirectory": str(REPO)})), 30)
    time.sleep(1.5)

    # (1) service detection itself works and returns (doesn't hang)
    _, sd = send(sc(ec("servicesList", {})), 20)
    results["services_list_ok"] = (True, f"{sd*1000:.0f}ms")

    # (2) baseline list_processes latency
    base = sorted(lp() for _ in range(8))
    results["baseline"] = (True, f"median={base[len(base)//2]*1000:.0f}ms max={base[-1]*1000:.0f}ms")

    # (3) concurrency under SEVERAL looping service-detection calls. One detection is
    #     fast (~150ms); the discriminator is parallelism — a pinned @MainActor runs
    #     them serially and saturates, while the fix runs them off-actor in parallel
    #     and keeps the actor free. So fan out a few holders to amplify the contrast.
    HOLDERS = 4
    state = {"done": 0, "err": None}
    def hold():
        try:
            send(sc(ec("waitForBoundPort", {"port": 59999, "timeoutMilliseconds": 3500})), t=20)
        except RuntimeError as e:
            state["err"] = str(e)  # expected: port_wait_timed_out
        finally:
            state["done"] += 1
    threads = [threading.Thread(target=hold) for _ in range(HOLDERS)]
    for th in threads: th.start()
    time.sleep(0.2)

    conc = []
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline and state["done"] < HOLDERS:
        conc.append(lp())
    for th in threads: th.join(timeout=20)

    conc_sorted = sorted(conc)
    conc_max = max(conc)
    results["concurrent_count"] = (len(conc) >= 100,
        f"{len(conc)} list_processes during the wait (a pinned actor lets far fewer through)")
    results["concurrent_latency"] = (conc_max < 0.30,
        f"median={conc_sorted[len(conc_sorted)//2]*1000:.0f}ms max={conc_max*1000:.0f}ms")
    results["wait_for_bound_port_returned"] = (state["done"] == HOLDERS, f"{state['done']}/{HOLDERS} err={state['err']}")

    # (4) server still healthy after
    _, after = send(sc(ec("listProcesses", {})), 10)
    results["server_alive_after"] = (after < 0.30, f"{after*1000:.0f}ms")

finally:
    if proc is not None and proc.poll() is None:
        proc.send_signal(signal.SIGINT)
        try: proc.wait(5)
        except subprocess.TimeoutExpired:
            proc.kill(); proc.wait(5)
    # End the tabs' sessions and daemon, and their holders and attach
    # adapters, with the cherry the app used; then delete PRIVATE.
    problems = cherry_private_host.stop_private_run(
        PRIVATE, cherry_private_host.development_cli(REPO, env, cwd=REPO))
    if problems:
        print("[mcp-conc] session host cleanup: " + "; ".join(problems), file=sys.stderr)
        results["private_host_cleaned_up"] = (False, "; ".join(problems))

print("\n[mcp-conc] RESULTS:")
ok = True
for k, (passed, detail) in results.items():
    ok = ok and passed
    print(f"   {'PASS' if passed else 'FAIL'}  {k:28} {detail}")
print(f"\n[mcp-conc] OVERALL: {'PASS' if ok else 'FAIL'}")
sys.exit(0 if ok else 1)
