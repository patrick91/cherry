{
  "name": "cherry-attention-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "astro check && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run build && vitest run",
    "types": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@cloudflare/workers-types": "5.20260722.1",
    "@types/node": "^22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "sharp": "0.35.0"
  }
}
