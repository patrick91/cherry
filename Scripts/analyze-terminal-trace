#!/usr/bin/env python3
import argparse
import re
from pathlib import Path


CSI_FINAL = range(0x40, 0x7F)


def escaped(data: bytes) -> str:
    out = []
    for byte in data:
        if byte == 0x1B:
            out.append("\\e")
        elif byte == 0x07:
            out.append("\\a")
        elif byte == 0x0A:
            out.append("\\n")
        elif byte == 0x0D:
            out.append("\\r")
        elif 0x20 <= byte < 0x7F:
            out.append(chr(byte))
        else:
            out.append(f"\\x{byte:02x}")
    return "".join(out)


def iter_csi(data: bytes):
    index = 0
    while True:
        start = data.find(b"\x1b[", index)
        if start < 0:
            return

        cursor = start + 2
        while cursor < len(data) and data[cursor] not in CSI_FINAL:
            cursor += 1

        if cursor >= len(data):
            return

        payload = data[start + 2:cursor].decode("ascii", "replace")
        yield start, cursor + 1, payload, chr(data[cursor])
        index = cursor + 1


def iter_osc(data: bytes):
    index = 0
    while True:
        start = data.find(b"\x1b]", index)
        if start < 0:
            return

        cursor = start + 2
        while cursor < len(data):
            if data[cursor] == 0x07:
                payload = data[start + 2:cursor].decode("utf-8", "replace")
                yield start, cursor + 1, payload, "BEL"
                break

            if data[cursor:cursor + 2] == b"\x1b\\":
                payload = data[start + 2:cursor].decode("utf-8", "replace")
                yield start, cursor + 2, payload, "ST"
                break

            cursor += 1
        else:
            return

        index = cursor + 1


def sgr_numbers(payload: str) -> list[int]:
    values = []
    for token in re.split(r"[;:]", payload):
        digits = "".join(ch for ch in token if ch.isdigit())
        if digits:
            values.append(int(digits))
    return values


def sgr_is_interesting(payload: str) -> bool:
    values = sgr_numbers(payload)
    return any(
        value == 7
        or value == 27
        or value == 38
        or value == 48
        or 40 <= value <= 49
        or 100 <= value <= 107
        for value in values
    )


def osc_is_interesting(payload: str) -> bool:
    selector = payload.split(";", 1)[0]
    return selector in {"4", "8", "10", "11", "12", "52"} or payload.endswith(";?")


def print_event(data: bytes, start: int, end: int, label: str, context: int):
    sequence = escaped(data[start:end])
    print(f"  @{start:#08x} {label}: {sequence}")
    if context > 0:
        lower = max(0, start - context)
        upper = min(len(data), end + context)
        print(f"    context: {escaped(data[lower:upper])}")


def analyze(path: Path, args):
    data = path.read_bytes()
    all_sgr = list(iter_csi(data))
    interesting_sgr = [
        item for item in all_sgr
        if item[3] == "m" and (args.all_sgr or sgr_is_interesting(item[2]))
    ]
    erase_line = [item for item in all_sgr if item[3] == "K"]
    osc = list(iter_osc(data))
    interesting_osc = [item for item in osc if args.all_osc or osc_is_interesting(item[2])]

    print(f"{path}")
    print(f"  bytes: {len(data)}")
    print(f"  CSI SGR: {sum(1 for item in all_sgr if item[3] == 'm')} total, {len(interesting_sgr)} shown")
    print(f"  CSI K: {len(erase_line)}")
    print(f"  OSC: {len(osc)} total, {len(interesting_osc)} shown")

    if interesting_osc:
        print("  OSC events:")
        for start, end, payload, terminator in interesting_osc[:args.limit]:
            print_event(data, start, end, f"OSC {terminator} payload={payload!r}", args.context)

    if interesting_sgr:
        print("  SGR color/reverse events:")
        for start, end, payload, final in interesting_sgr[:args.limit]:
            print_event(data, start, end, f"CSI {payload}{final}", args.context)

    if erase_line and args.show_erase:
        print("  Erase-line events:")
        for start, end, payload, final in erase_line[:args.limit]:
            print_event(data, start, end, f"CSI {payload}{final}", args.context)

    if not interesting_sgr and any(item[2] in {"10;?", "11;?"} for item in osc):
        print("  clue: the app queried terminal colors but did not emit visible background SGR later.")


def main():
    parser = argparse.ArgumentParser(description="Inspect raw Cherry PTY traces for terminal rendering sequences.")
    parser.add_argument("paths", nargs="+", type=Path)
    parser.add_argument("--all-sgr", action="store_true", help="show every SGR sequence, not just color/reverse sequences")
    parser.add_argument("--all-osc", action="store_true", help="show every OSC sequence")
    parser.add_argument("--show-erase", action="store_true", help="show CSI K erase-line events")
    parser.add_argument("--context", type=int, default=0, help="bytes of escaped context around each event")
    parser.add_argument("--limit", type=int, default=80, help="maximum events per section")
    args = parser.parse_args()

    for index, path in enumerate(args.paths):
        if index:
            print()
        analyze(path, args)


if __name__ == "__main__":
    main()
