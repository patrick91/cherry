#!/usr/bin/env bash
# Build a self-contained local-test disk image without replacing an installed app.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
app_name=${CHERRY_APP_NAME:-Cherry Sessions}
bundle_id=${CHERRY_BUNDLE_ID:-dev.patrick.cherry.sessions}
url_scheme=${CHERRY_URL_SCHEME:-cherry-sessions}
support_name=${CHERRY_APPLICATION_SUPPORT_NAME:-Cherry Sessions}
icon=${CHERRY_ICON_PATH:-"$root/Design/SessionsIcon/AppIconSessions.icns"}
architecture=$(uname -m)
output="$root/dist/$app_name-$architecture.dmg"
mkdir -p "$root/.build" "$root/dist"
stage=$(mktemp -d "$root/.build/dmg.XXXXXX")
trap 'rm -rf "$stage"' EXIT

# The disk image always contains the session helpers, universal (arm64 and
# x86_64), whatever the caller's CHERRY_SKIP_HOST or CHERRY_HOST_ARCHS says.
CHERRY_CONFIGURATION=release CHERRY_APP_NAME="$app_name" CHERRY_INSTALL_DIR="$stage" \
  CHERRY_SKIP_HOST=0 CHERRY_HOST_ARCHS=universal CHERRY_BUNDLE_ID="$bundle_id" CHERRY_URL_SCHEME="$url_scheme" \
  CHERRY_APPLICATION_SUPPORT_NAME="$support_name" CHERRY_ICON_PATH="$icon" \
  "$root/Scripts/install-local-app"
ln -s /Applications "$stage/Applications"

cat > "$stage/Start Here.txt" <<EOF
$app_name — persistent session test build

Requires macOS 26 or later on $architecture.

This separate app can run alongside your current Cherry. It has its own
identifier ($bundle_id), icon, settings,
and application data. Your existing Cherry installation is not replaced.

1. Drag $app_name.app to Applications, then open it from Applications.
   While it runs from the disk image, its local tabs are ordinary tabs.
2. Open a project. Its terminal, command and agent tabs run as persistent
   sessions (Settings > Sessions turns this off).
3. Start a shell command or editor in a tab, then quit $app_name and choose
   Keep Running when it asks about the running sessions.
4. Open it again: the tab comes back with the original process and terminal
   state. Closing a tab (Command-W) ends its session; Detach Tab (Command-D)
   keeps it running in the background.
5. File > Persistent Sessions (Command-Shift-R) lists the sessions on This Mac
   and on SSH hosts, and creates and attaches to more.

You can attach to the same session on another device while this one stays
connected. Both terminals can type and see the same output. The shared
terminal fits the smallest attached window and grows when it disconnects.
Larger windows show the active screen; their native scrollback is unavailable
while a smaller terminal determines the shared size. The host keeps its
bounded history. Terminate stops the session; disconnecting does not.

Both cherry and cherry-host are included inside:
  $app_name.app/Contents/MacOS/
Local persistent sessions work without a separate command-line installation.

For another Mac, choose Add Mac… in the project picker: once key-based SSH
login works, it checks that Mac and installs this app's cherry and
cherry-host there (in ~/Library/Application Support/cherry-host/bin; both
are universal, for Apple silicon and Intel Macs alike). For any other SSH
host, put cherry-host on that machine's SSH command PATH and add its SSH
alias in Persistent Sessions. The portable host can also be built for Linux
from the source repository.

Sessions survive quitting or a crash of $app_name, SSH disconnection, and a
crash or restart of the host daemon: each session's own holder process keeps
it running. They end when that machine reboots.

Updating the app does not end sessions. A host daemon that speaks an older
protocol is replaced when the new version connects, and its sessions carry
on. On another Mac, choose Update Session Host… in its menu of the project
picker; on another SSH host, put the new cherry-host on its SSH command PATH.
A daemon that speaks a newer protocol than this app is reported, never
replaced.

This is a locally signed test build; it is not notarized for distribution.
EOF

codesign --verify --deep --strict "$stage/$app_name.app"
# The helpers Cherry installs on the user's other Macs cover both kinds.
"$root/Scripts/check-helper-archs" "$stage/$app_name.app/Contents/MacOS/cherry" "$stage/$app_name.app/Contents/MacOS/cherry-host"
"$root/Scripts/test-packaged-app" "$stage/$app_name.app"
hdiutil create -volname "$app_name" -srcfolder "$stage" -format UDZO -ov "$output"
hdiutil verify "$output"
shasum -a 256 "$output" > "$output.sha256"
printf 'Created %s\n' "$output"
