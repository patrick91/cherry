#!/bin/sh
# A stand-in for another Mac reached over SSH, for tests of devices
# (docs/specs/remote-devices.md). It never runs the real ssh and never
# touches the user's session host, ~/.ssh or Application Support.
#
#   Scripts/fake-remote-mac setup DIR NAME [NAME...]
#   Scripts/fake-remote-mac stop DIR
#
# setup writes DIR/bin/ssh, an `ssh` to put first on PATH (alone: PATH=DIR/bin),
# and one fake Mac per NAME under DIR/hosts/NAME:
#   home/        its private HOME
#   bin/         first on its PATH: cherry and cherry-host (links to the
#                debug builds, or $CHERRY_FAKE_REMOTE_BIN), and stand-ins for
#                `scutil` (ComputerName "Fake NAME") and `security` (a locked
#                keychain), so a check reads nothing of this Mac's
#   host.sock    its session host's socket (CHERRY_HOST_SOCKET there)
#
# The shim takes ssh's options, refuses master connections (-M, -O: masters
# are off, as FakeSSH in HostControlSSHMasterTests) unless DIR/masters
# exists, and runs the remote command with /bin/sh -c under `env -i` with
# that Mac's HOME, PATH, SHELL and CHERRY_HOST_SOCKET, so its cherry-host
# gateway serves the private daemon. Standard input and output pass through
# (the gateway's frames, a check's script, scp's protocol). Behaviour
# switches, files in DIR:
#   masters       `-M` runs a stand-in master (its ControlPath is a plain
#                 file while it runs; `-O check` and `-O exit` work), and a
#                 command given `-o ControlPath=P` of a running master is one
#                 of its sessions: at most the number in DIR/max-sessions
#                 (default 10) run at once, as sshd's MaxSessions, and one
#                 more fails with "Session open refused by peer" (255).
#                 `-O forward -L SPEC` and `-O cancel -L SPEC` on a running
#                 master succeed and append "forward|cancel PATH SPEC" to
#                 DIR/forwards (nothing listens: the loopback test makes a
#                 real forward); with DIR/forward-fails a forward fails as
#                 ssh does when its local port is taken. `-O forward -R
#                 THERE:HERE` (a Unix socket forwarded to this Mac, Cherry
#                 MCP) links THERE to HERE, which bridges them since the fake
#                 Mac's files are this Mac's; like sshd it fails when THERE
#                 exists (StreamLocalBindUnlink no), and always with
#                 DIR/remote-forward-fails (a server that refuses, as with
#                 AllowStreamLocalForwarding no). `-O cancel -R` removes the
#                 link. Both are logged to DIR/forwards too.
# and in DIR/hosts/NAME:
#   offline   ssh: connect to host NAME port 22: Connection timed out (255)
#   hostkey   Host key verification failed. (255)
#   denied    NAME: Permission denied (publickey). (255)
#   arch      its contents (e.g. x86_64) are the architecture `uname -m`
#             and `uname -sm` report there (a stand-in `uname`)
#   no-gui    its `osascript` stand-in fails as osascript does over SSH
#             with nobody logged in there
#   shell     its contents (e.g. /bin/zsh) are its login shell, the SHELL
#             every command there sees (default /bin/sh); that shell's
#             startup files are home/'s (home/.zshrc for zsh), so a test can
#             put a tool on PATH only for interactive shells there
# As sshd does, the shim runs every `sh -s` script (a check, an install, the
# login environment's read) in a session of its own without a controlling
# terminal, so an interactive shell such a script starts never takes the
# terminal the tests run in (other commands run as before).
# Every fake Mac has that `osascript` stand-in first on its PATH, so the
# real one (which would set this Mac's clipboard) never runs: `set the
# clipboard to (read (POSIX file "P") as «class PNGf»)` copies P to
# clipboard.png there, `clipboard info for «class PNGf»` reports it, and
# each script is logged to osascript-calls there.
#
# What cherry-host a fake Mac has (CHERRY_FAKE_REMOTE_HOST at setup):
#   link      (the default) cherry and cherry-host on its PATH, linked to the
#             debug builds
#   none      none (CHERRY_FAKE_REMOTE_NO_HOST=1 is the same)
#   newer     on its PATH, a stand-in cherry-host of protocol 99 whose
#             status reports a running daemon of protocol 99 (a newer
#             Cherry there); its gateway refuses
#   old-build none on its PATH; copies of the debug builds installed as
#             this Cherry installs them, in home/Library/Application
#             Support/cherry-host/bin/20200101000000.old (a test starts
#             the daemon from there with CHERRY_HOST_TEST_BUILD set to
#             that build)
# A NAME that is a symlink to another fake Mac's directory is that Mac (an
# alias). An unknown NAME: Could not resolve hostname (255). Every call is logged
# to DIR/calls.
#
# stop makes the shim refuse every further connection (DIR/stopped), then
# ends the daemons and holders serving DIR's sockets (matched by their
# private socket paths, never by name), again until none is left, and
# removes nothing else.
set -eu

usage() {
  echo "Usage: Scripts/fake-remote-mac setup DIR NAME [NAME...] | stop DIR" >&2
  exit 2
}

[ $# -ge 2 ] || usage
command=$1
dir=$2
shift 2

case "$command" in
  setup)
    [ $# -ge 1 ] || usage
    root=$(cd "$(dirname "$0")/.." && pwd)
    binaries=${CHERRY_FAKE_REMOTE_BIN:-${CARGO_TARGET_DIR:-$root/Host/target}/debug}
    mkdir -p "$dir/bin" "$dir/hosts"
    chmod 700 "$dir" "$dir/bin" "$dir/hosts"
    dir=$(cd "$dir" && pwd -P)
    for name in "$@"; do
      case "$name" in
        *[!A-Za-z0-9._-]*|'') echo "fake-remote-mac: bad name $name" >&2; exit 2 ;;
      esac
      host="$dir/hosts/$name"
      mkdir -p "$host/home" "$host/bin"
      chmod 700 "$host" "$host/home" "$host/bin"
      kind=${CHERRY_FAKE_REMOTE_HOST:-link}
      [ "${CHERRY_FAKE_REMOTE_NO_HOST:-}" = 1 ] && kind=none
      case "$kind" in
        link)
          for tool in cherry cherry-host; do
            if [ -x "$binaries/$tool" ]; then ln -sf "$binaries/$tool" "$host/bin/$tool"; fi
          done
          ;;
        none) ;;
        newer)
          cat > "$host/bin/cherry-host" <<'EOF'
#!/bin/sh
case "${1-}" in
  version) echo '{"protocol":99,"build":"29990101000000.future","version":"9.0.0","os":"macos","arch":"aarch64","min_macos":"11.0"}' ;;
  status) echo '{"running":true,"state":"ready","protocol":99,"build":"29990101000000.future","host_id":"fake-newer-host"}' ;;
  *) echo "cherry-host: this stand-in speaks protocol 99 only" >&2; exit 1 ;;
esac
EOF
          chmod 700 "$host/bin/cherry-host"
          ;;
        old-build)
          old="$host/home/Library/Application Support/cherry-host/bin/20200101000000.old"
          mkdir -p "$old"
          for tool in cherry cherry-host; do cp "$binaries/$tool" "$old/$tool"; done
          ;;
        *) echo "fake-remote-mac: CHERRY_FAKE_REMOTE_HOST must be link, none, newer or old-build" >&2; exit 2 ;;
      esac
      quoted_host=$(printf "%s" "$host" | sed "s/'/'\\\\''/g")
      cat > "$host/bin/uname" <<EOF
#!/bin/sh
host='$quoted_host'
EOF
      cat >> "$host/bin/uname" <<'EOF'
if [ -f "$host/arch" ]; then
  arch=$(cat "$host/arch")
  case "$*" in
    -sm) echo "Darwin $arch"; exit 0 ;;
    -m) echo "$arch"; exit 0 ;;
  esac
fi
exec /usr/bin/uname "$@"
EOF
      chmod 700 "$host/bin/uname"
      cat > "$host/bin/scutil" <<EOF
#!/bin/sh
case "\$*" in
  "--get ComputerName") echo "Fake $name" ;;
  "--get LocalHostName") echo "fake-$name" ;;
  *) exit 1 ;;
esac
EOF
      cat > "$host/bin/security" <<'EOF'
#!/bin/sh
echo "security: SecKeychainCopySettings: User interaction is not allowed." >&2
exit 36
EOF
      chmod 700 "$host/bin/scutil" "$host/bin/security"
      # osascript: never the real one (it would set this Mac's clipboard).
      cat > "$host/bin/osascript" <<EOF
#!/bin/sh
host='$quoted_host'
EOF
      cat >> "$host/bin/osascript" <<'EOF'
[ "${1-}" = -e ] || { echo "osascript stand-in: only -e SCRIPT" >&2; exit 2; }
printf '%s\n' "$2" >> "$host/osascript-calls"
if [ -f "$host/no-gui" ]; then
  echo "0:0: execution error: An error of type -10810 has occurred. (-10810)" >&2
  exit 1
fi
case "$2" in
  "set the clipboard to (read (POSIX file "*)
    path=$(printf '%s' "$2" | /usr/bin/sed -n 's/.*POSIX file "\([^"]*\)".*/\1/p')
    [ -f "$path" ] || { echo "0:0: execution error: File not found. (-43)" >&2; exit 1; }
    /bin/cp "$path" "$host/clipboard.png" ;;
  "clipboard info for "*)
    if [ -f "$host/clipboard.png" ]; then
      printf '«class PNGf», %s\n' "$(/usr/bin/wc -c < "$host/clipboard.png" | /usr/bin/tr -d ' ')"
    fi ;;
  *) echo "osascript stand-in: unknown script" >&2; exit 1 ;;
esac
EOF
      chmod 700 "$host/bin/osascript"
    done
    quoted=$(printf "%s" "$dir" | sed "s/'/'\\\\''/g")
    cat > "$dir/bin/ssh" <<EOF
#!/bin/sh
dir='$quoted'
EOF
    cat >> "$dir/bin/ssh" <<'EOF'
printf '%s\n' "$*" >> "$dir/calls"
if [ -f "$dir/stopped" ]; then
  echo "fake-remote-mac: this fake Mac was stopped" >&2
  exit 255
fi
destination=
master=no
control=
path=
spec=
rspec=
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; destination=${1-}; [ $# -gt 0 ] && shift; break ;;
    -M|-O*)
      if [ ! -f "$dir/masters" ]; then echo "fake-remote-mac: SSH master connections are off" >&2; exit 255; fi
      case "$1" in
        -M) master=yes ;;
        -O) shift; control=${1-} ;;
        -O*) control=${1#-O} ;;
      esac ;;
    -o)
      shift
      case "${1-}" in ControlPath=*) path=${1#ControlPath=} ;; esac ;;
    -oControlPath=*) path=${1#-oControlPath=} ;;
    -L) shift; spec=${1-} ;;
    -R) shift; rspec=${1-} ;;
    -[BbcDEeFIiJlmpQRSWw]) shift ;;
    -*) ;;
    *) destination=$1; shift; break ;;
  esac
  shift
done
# ssh doubles % in a ControlPath.
path=$(printf '%s' "$path" | /usr/bin/sed 's/%%/%/g')
if [ -n "$control" ]; then
  case "$control" in
    check) [ -n "$path" ] && [ -e "$path" ] && exit 0
           echo "Control socket connect($path): No such file or directory" >&2; exit 255 ;;
    exit) [ -f "$path.pid" ] && kill -TERM "$(/bin/cat "$path.pid")"; echo "Exit request sent." >&2; exit 0 ;;
    forward|cancel)
      if [ -z "$path" ] || [ ! -f "$path.pid" ]; then
        echo "Control socket connect($path): No such file or directory" >&2; exit 255
      fi
      if [ -n "$rspec" ]; then
        there=${rspec%%:*}
        here=${rspec#*:}
        if [ "$control" = forward ]; then
          if [ -f "$dir/remote-forward-fails" ]; then
            echo "mux_client_forward: forwarding request failed: remote port forwarding failed for listen path $there" >&2; exit 255
          fi
          if [ -e "$there" ] || [ -L "$there" ]; then
            echo "mux_client_forward: forwarding request failed: remote port forwarding failed for listen path $there" >&2; exit 255
          fi
          /bin/ln -s "$here" "$there" || exit 255
        else
          [ -L "$there" ] && /bin/rm -f "$there"
        fi
        printf '%s %s -R %s\n' "$control" "$path" "$rspec" >> "$dir/forwards"
        exit 0
      fi
      if [ "$control" = forward ] && [ -f "$dir/forward-fails" ]; then
        echo "mux_client_forward: forwarding request failed: Port forwarding failed" >&2; exit 255
      fi
      printf '%s %s %s\n' "$control" "$path" "$spec" >> "$dir/forwards"
      exit 0 ;;
    *) exit 255 ;;
  esac
fi
name=${destination#*@}
host="$dir/hosts/$name"
if [ -z "$name" ] || [ ! -d "$host" ]; then
  echo "ssh: Could not resolve hostname $name: nodename nor servname provided, or not known" >&2
  exit 255
fi
# Another name for the same Mac (a symlink) is that Mac.
host=$(cd "$host" && pwd -P)
if [ -f "$host/offline" ]; then
  echo "ssh: connect to host $name port 22: Connection timed out" >&2
  exit 255
fi
if [ -f "$host/hostkey" ]; then
  echo "No ED25519 host key is known for $name and you have requested strict checking." >&2
  echo "Host key verification failed." >&2
  exit 255
fi
if [ -f "$host/denied" ]; then
  echo "$name: Permission denied (publickey)." >&2
  exit 255
fi
if [ "$master" = yes ]; then
  if [ -z "$path" ]; then echo "fake-remote-mac: a master needs a ControlPath" >&2; exit 255; fi
  printf '%s' "$$" > "$path.pid"
  trap '/bin/rm -f "$path" "$path.pid"; /bin/rm -rf "$path.ch"; exit 0' TERM INT HUP
  : > "$path"
  /bin/mkdir -p "$path.ch"
  while :; do /bin/sleep 0.1; done
fi
if [ $# -eq 0 ]; then
  echo "fake-remote-mac: no remote command (interactive logins are not faked)" >&2
  exit 255
fi
login_shell=/bin/sh
if [ -f "$host/shell" ]; then login_shell=$(/bin/cat "$host/shell"); fi
command_line=$*
# Runs the remote command with that Mac's environment; an `sh -s` script in
# a session of its own (perl: fork, setsid, exec; TERM and HUP passed on).
remote() {
  set -- /usr/bin/env -i \
    HOME="$host/home" \
    USER="${USER:-}" LOGNAME="${LOGNAME:-}" \
    PATH="$host/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    SHELL="$login_shell" \
    LANG="${LANG:-en_US.UTF-8}" \
    TMPDIR="${TMPDIR:-/tmp}" \
    CHERRY_HOST_SOCKET="$host/host.sock" \
    /bin/sh -c "$command_line"
  if [ "$command_line" = "sh -s" ]; then
    /usr/bin/perl -e 'use POSIX (); my $pid = fork(); die "fork: $!\n" unless defined $pid;
      if ($pid == 0) { POSIX::setsid(); exec { $ARGV[0] } @ARGV or die "exec $ARGV[0]: $!\n"; }
      $SIG{TERM} = sub { kill "TERM", $pid }; $SIG{HUP} = sub { kill "HUP", $pid };
      waitpid($pid, 0); exit(($? & 127) ? 128 + ($? & 127) : ($? >> 8));' "$@"
  else
    "$@"
  fi
}
if [ -n "$path" ] && [ -f "$path.pid" ] && [ -d "$path.ch" ]; then
  # A session of a running master: MaxSessions.
  max=10
  [ -f "$dir/max-sessions" ] && max=$(/bin/cat "$dir/max-sessions")
  count=0
  for f in "$path.ch"/*; do
    [ -f "$f" ] || continue
    if kill -0 "${f##*/}" 2>/dev/null; then count=$((count + 1)); else /bin/rm -f "$f"; fi
  done
  if [ "$count" -ge "$max" ]; then
    echo "mux_client_request_session: session request failed: Session open refused by peer" >&2
    exit 255
  fi
  : > "$path.ch/$$"
  printf '%s\n' "$path" >> "$dir/sessions"
  remote
  status=$?
  /bin/rm -f "$path.ch/$$"
  exit $status
fi
if [ "$command_line" = "sh -s" ]; then
  remote
  exit $?
fi
exec /usr/bin/env -i \
  HOME="$host/home" \
  USER="${USER:-}" LOGNAME="${LOGNAME:-}" \
  PATH="$host/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
  SHELL="$login_shell" \
  LANG="${LANG:-en_US.UTF-8}" \
  TMPDIR="${TMPDIR:-/tmp}" \
  CHERRY_HOST_SOCKET="$host/host.sock" \
  /bin/sh -c "$command_line"
EOF
    chmod 700 "$dir/bin/ssh"
    echo "$dir/bin"
    ;;
  stop)
    # From now on the shim refuses every connection (a tombstone), so a
    # connection attempt still under way cannot start a daemon again.
    [ -d "$dir" ] && : > "$dir/stopped"
    # Stand-in masters (DIR/masters) of this DIR, by the pid each wrote.
    for pidfile in "$dir"/*.pid "$dir"/*/*.pid; do
      [ -f "$pidfile" ] || continue
      kill -TERM "$(cat "$pidfile")" 2>/dev/null || true
    done
    [ -d "$dir/hosts" ] || exit 0
    # The daemons and holders serving DIR's sockets, until none has been
    # seen for half a second (a gateway that was already running may start
    # one late); TERM first, KILL after 3 seconds; 10 seconds at most.
    quiet=0
    tries=0
    while [ "$quiet" -lt 5 ] && [ "$tries" -lt 100 ]; do
      found=0
      for host in "$dir"/hosts/*; do
        [ -d "$host" ] || continue
        socket="$host/host.sock"
        if pgrep -f "serve --socket $socket" >/dev/null 2>&1 || pgrep -f "hold --socket $socket" >/dev/null 2>&1; then
          found=1
          if [ "$tries" -lt 30 ]; then
            pkill -TERM -f "serve --socket $socket" 2>/dev/null || true
          else
            pkill -KILL -f "serve --socket $socket" 2>/dev/null || true
          fi
          pkill -KILL -f "hold --socket $socket" 2>/dev/null || true
        fi
      done
      if [ "$found" = 1 ]; then quiet=0; else quiet=$((quiet + 1)); fi
      tries=$((tries + 1))
      /bin/sleep 0.1
    done
    ;;
  *)
    usage
    ;;
esac
