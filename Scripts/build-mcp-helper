#!/usr/bin/env bash
# Build CherryMCP, the MCP helper, universal (arm64 and x86_64): Cherry
# installs it on the user's other Macs next to cherry and cherry-host, for
# agents in their tabs (docs/specs/remote-devices.md, phase 4b). Each
# architecture is its own SwiftPM build (--triple), joined with lipo
# (Scripts/build-universal).
#
#   Scripts/build-mcp-helper [debug|release]
#
# Prints the universal executable's path (.build/universal/<configuration>/
# CherryMCP). CHERRY_HOST_ARCHS=native builds this Mac's architecture only,
# as Scripts/build-host does, and says so. CHERRY_SWIFT_BUILD_ARGS go to each
# `swift build` (release mode: --force-resolved-versions). CherryMCP needs
# the macOS the package declares (Package.swift) on that Mac too.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
configuration=${1:-release}
case "$configuration" in debug|release) ;; *) echo "Usage: Scripts/build-mcp-helper [debug|release]" >&2; exit 1;; esac

case "${CHERRY_HOST_ARCHS:-universal}" in
  universal) ;;
  native)
    echo "note: building CherryMCP for $(uname -m) only (CHERRY_HOST_ARCHS=native); agents on a Mac of the other architecture cannot use Cherry MCP" >&2
    ;;
  *) echo "CHERRY_HOST_ARCHS must be universal or native, not '${CHERRY_HOST_ARCHS}'" >&2; exit 1 ;;
esac

# shellcheck disable=SC2086 # CHERRY_SWIFT_BUILD_ARGS is split on purpose; its flags contain no spaces.
exec "$root/Scripts/build-universal" CherryMCP "$configuration" --archs "${CHERRY_HOST_ARCHS:-universal}" -- ${CHERRY_SWIFT_BUILD_ARGS:-}
