#!/usr/bin/env python3
"""Exercise a packaged Cherry terminal with the source checkout inaccessible.

Run in a logged-in macOS GUI session:
    Scripts/test-packaged-app '/path/to/Cherry Sessions.app'

The source app is verified, copied, given disposable preferences, and launched
under a per-process sandbox. No shared build directories are moved or changed.
Opening a real project and reading a command's rendered terminal output catches
resource lookup failures that a launch-only check (or the developer's checkout)
can conceal. The temporary test window is closed when the check finishes.

The bundled cherry and cherry-host helpers run under the same sandbox against a
private socket: they must start a daemon, create, list, kill and remove a
session, and shut the daemon down without the checkout's Host/target builds.

Local tabs are persistent sessions by default, so the GUI gets its own session
host too: CHERRY_HOST_SOCKET and CHERRY_CONTROL_SOCKET name sockets in a
private (0700) directory of the fixture, never the user's daemon or app, and
its tabs must run on that host. When the check finishes, every session there
is killed and removed, the daemon is shut down, anything else still running
from the fixture (holders, attach adapters) is killed, and the fixture,
including the host's state directory under its HOME, is deleted.
"""

import argparse
import json
import os
from pathlib import Path
import plistlib
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import uuid

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import cherry_private_host  # noqa: E402


REPOSITORY = Path(__file__).resolve().parent.parent
HELPERS = ("cherry", "cherry-host")


def run(*command, **kwargs):
    return subprocess.run(command, check=True, capture_output=True, text=True, **kwargs)


def request(name, fields=None):
    return {name: {} if fields is None else {"_0": fields}}


def json_object(text, description):
    """Parse output that must be one JSON object, failing with a readable error."""
    try:
        value = json.loads(text)
    except ValueError as error:
        raise RuntimeError(f"{description} is not JSON ({error}): {text.strip()[:500]!r}") from None
    if not isinstance(value, dict):
        raise RuntimeError(f"{description} is not a JSON object: {text.strip()[:500]!r}")
    return value


def control(socket_path, value, timeout=3):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(timeout)
        connection.connect(str(socket_path))
        connection.sendall(json.dumps(value).encode() + b"\n")
        connection.shutdown(socket.SHUT_WR)
        response = bytearray()
        while not response.endswith(b"\n"):
            chunk = connection.recv(65536)
            if not chunk:
                break
            response.extend(chunk)
    if not response:
        raise RuntimeError("Cherry closed the control connection without a response")
    decoded = json_object(response.decode(errors="replace"), "Cherry control response")
    if decoded.get("error"):
        raise RuntimeError(f"Cherry control error: {decoded['error']}")
    result = decoded.get("result")
    payload = next(iter(result.values()), None) if isinstance(result, dict) else None
    if not isinstance(payload, dict) or "_0" not in payload:
        raise RuntimeError(f"Unexpected Cherry control response: {decoded}")
    return payload["_0"]


def check_running(process):
    if process.poll() is not None:
        raise RuntimeError(f"Packaged GUI exited unexpectedly (status {process.returncode})")


def architectures(path):
    return set(run("/usr/bin/lipo", "-archs", str(path)).stdout.split())


def check_bundle_contents(app, skip_helpers):
    """Reject test resources and missing or wrong-architecture helpers."""
    test_bundles = sorted(path.name for path in (app / "Contents/Resources").glob("*Tests*.bundle"))
    if test_bundles:
        raise RuntimeError(f"App bundle contains test resource bundles: {', '.join(test_bundles)}")
    if skip_helpers:
        return
    with (app / "Contents/Info.plist").open("rb") as file:
        gui = app / "Contents/MacOS" / plistlib.load(file)["CFBundleExecutable"]
    required = architectures(gui)
    for name in HELPERS:
        helper = app / "Contents/MacOS" / name
        if not helper.is_file() or not os.access(helper, os.X_OK):
            raise RuntimeError(f"Missing bundled session helper {helper} "
                               "(an app built with CHERRY_SKIP_HOST=1 needs --skip-helpers)")
        missing = required - architectures(helper)
        if missing:
            raise RuntimeError(f"{name} lacks the app's architectures: {' '.join(sorted(missing))}")


def host_reachable(socket_path):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(1)
        try:
            connection.connect(str(socket_path))
        except OSError:
            return False
    return True


def wait_until(predicate, timeout, message):
    deadline = time.monotonic() + timeout
    while True:
        value = predicate()
        if value:
            return value
        if time.monotonic() >= deadline:
            raise RuntimeError(message)
        time.sleep(0.1)


def exercise_helpers(app, sandbox, environment, fixture):
    """Drive the bundled CLI and daemon through a whole session lifecycle."""
    cli = app / "Contents/MacOS/cherry"
    host = app / "Contents/MacOS/cherry-host"
    versions = [run(*sandbox, str(path), "--version", env=environment, timeout=15).stdout.split()
                for path in (cli, host)]
    if not all(versions) or versions[0][-1] != versions[1][-1]:
        raise RuntimeError(f"Bundled helper versions differ or are missing: {versions}")

    # The daemon refuses a socket directory that is not private to this user.
    state = fixture / "h"
    state.mkdir(mode=0o700)
    state.chmod(0o700)
    socket_path = state / "host.sock"

    def cherry(*arguments):
        result = subprocess.run(sandbox + [str(cli), "--socket", str(socket_path), *arguments],
                                env=environment, cwd=fixture, capture_output=True, text=True, timeout=30)
        if result.returncode != 0:
            raise RuntimeError(f"Bundled `cherry {' '.join(arguments)}` failed with status "
                               f"{result.returncode}: {result.stderr.strip()}")
        return result.stdout

    def session(session_id):
        listing = json_object(cherry("list", "--json"), "`cherry list --json` output")
        sessions = listing.get("sessions")
        if not isinstance(sessions, list) or not all(isinstance(item, dict) for item in sessions):
            raise RuntimeError(f"`cherry list --json` has no list of session objects: {listing}")
        return next((item for item in sessions if item.get("id") == session_id), None)

    session_id = None
    stopped = False
    try:
        # `new` starts the daemon from the sibling cherry-host.
        lines = [line for line in cherry("new", "--name=packaged-helper-smoke", f"--cwd={fixture}",
                                         "--", "/bin/sh", "-c", "sleep 30").splitlines() if line.strip()]
        if not lines:
            raise RuntimeError("Bundled `cherry new` printed no session")
        created = json_object(lines[-1], "`cherry new` output")
        if not isinstance(created.get("id"), str) or not created["id"]:
            raise RuntimeError(f"Bundled `cherry new` printed no session id: {created}")
        session_id = created["id"]
        if created.get("state") != "running":
            raise RuntimeError(f"Bundled helpers did not start the session: {created}")
        listed = session(session_id)
        if listed is None or listed.get("state") != "running":
            raise RuntimeError(f"list --json does not show the running session: {listed}")
        cherry("kill", session_id)
        wait_until(lambda: (session(session_id) or {}).get("state") == "exited", 15,
                   "Killed session never reported state exited")
        cherry("remove", session_id)
        if session(session_id) is not None:
            raise RuntimeError("Removed session is still listed")
        session_id = None
        cherry("shutdown")
        wait_until(lambda: not host_reachable(socket_path), 10, "Bundled daemon did not shut down")
        stopped = True
        print("Verified bundled cherry and cherry-host run a session lifecycle with checkout hidden.", flush=True)
    finally:
        if not stopped and host_reachable(socket_path):
            for arguments in ([["kill", session_id]] if session_id else []) + [["shutdown"]]:
                subprocess.run(sandbox + [str(cli), "--socket", str(socket_path), *arguments],
                               env=environment, capture_output=True, timeout=30)
            time.sleep(0.5)
            if host_reachable(socket_path):
                # Nothing else uses this private socket path.
                subprocess.run(["/usr/bin/pkill", "-f", str(socket_path)], capture_output=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("app", type=Path)
    parser.add_argument("--timeout", type=float, default=45,
                        help="Maximum seconds for GUI startup and terminal output (default: 45)")
    parser.add_argument("--deny-path", action="append", default=[], type=Path,
                        help="Also make this source/build directory inaccessible to the app")
    parser.add_argument("--keep-fixture", action="store_true",
                        help="Retain the isolated app, home, sandbox profile, and log for diagnosis")
    parser.add_argument("--skip-helpers", action="store_true",
                        help="The app was built with CHERRY_SKIP_HOST=1; skip the session helper checks")
    args = parser.parse_args()
    original = args.app.expanduser().resolve()
    if sys.platform != "darwin" or not Path("/usr/bin/sandbox-exec").exists():
        parser.error("This check requires macOS, sandbox-exec, and a logged-in GUI session")
    if not (original / "Contents/Info.plist").is_file():
        parser.error(f"Not an application bundle: {original}")
    if args.timeout <= 0:
        parser.error("--timeout must be positive")

    run("/usr/bin/codesign", "--verify", "--deep", "--strict", str(original))
    check_bundle_contents(original, args.skip_helpers)
    fixture = Path(tempfile.mkdtemp(prefix="cherry-package-", dir="/private/tmp"))
    process = None
    log = fixture / "app.log"
    terminal_ids = []
    # The GUI's control server and session host listen here, private to this
    # run (the host refuses a socket directory that is not 0700).
    sockets = fixture / "sockets"
    socket_path = sockets / "control.sock"
    host_socket = sockets / "host.sock"
    project = fixture / "project"
    home = fixture / "home"
    cli = None
    sandbox = None
    environment = None
    bundle_id = None
    success = False
    try:
        sockets.mkdir(mode=0o700)
        sockets.chmod(0o700)
        app = fixture / original.name
        shutil.copytree(original, app, symlinks=True)
        info_path = app / "Contents/Info.plist"
        with info_path.open("rb") as file:
            info = plistlib.load(file)
        unique = uuid.uuid4().hex
        info["CFBundleIdentifier"] = "dev.patrick.cherry.packaged-smoke." + unique
        info["CherryApplicationSupportName"] = "Cherry Package Smoke " + unique
        info["CherryURLScheme"] = "cherry-package-smoke-" + unique
        info.pop("CFBundleURLTypes", None)
        # Exercise Cherry's own resource-bundle lookup as well as Ghostty's:
        # the default fallback Dock icon is loaded through CherryResources.
        info.pop("CFBundleIconFile", None)
        info.pop("CFBundleIconName", None)
        with info_path.open("wb") as file:
            plistlib.dump(info, file)
        bundle_id = info["CFBundleIdentifier"]
        run("/usr/bin/codesign", "--force", "--deep", "--sign", "-", str(app))
        executable = app / "Contents/MacOS" / info["CFBundleExecutable"]

        # Always hide this checkout. Also detect compiled SwiftPM .build paths
        # in case the artifact was built from a different checkout on this Mac.
        denied = {str(REPOSITORY), *(str(path.expanduser().resolve()) for path in args.deny_path)}
        for line in run("/usr/bin/strings", "-a", str(executable)).stdout.splitlines():
            match = re.match(r"^(/[^\r\n]*?)/\.build(?:/|$)", line)
            if match:
                denied.add(match.group(1))
        sentinel = fixture / "hidden-build-probe"
        sentinel.write_text("the child must not be able to read this file\n")
        denied.add(str(sentinel))
        profile = fixture / "sandbox.sb"
        # macOS refuses setuid login inside a seatbelt sandbox. Only that
        # system child may run normally; Cherry itself remains sandboxed, so
        # its resource resolution cannot access any source/build fallback.
        profile.write_text("(version 1)\n(allow default)\n"
                           '(allow process-exec (with no-sandbox) (literal "/usr/bin/login"))\n' + "".join(
            f"(deny file-read* (subpath {json.dumps(path)}))\n" for path in sorted(denied)
        ))
        sandbox = ["/usr/bin/sandbox-exec", "-f", str(profile)]
        # Fail closed if the policy cannot be applied, or stops denying reads.
        probe = subprocess.run(sandbox + ["/bin/cat", str(sentinel)], capture_output=True, text=True)
        if probe.returncode == 0 or "Operation not permitted" not in probe.stderr:
            raise RuntimeError(f"Resource isolation sandbox failed its read-denial probe: {probe.stderr}")
        for path in sorted(denied - {str(sentinel)}):
            if Path(path).exists():
                probe = subprocess.run(sandbox + ["/usr/bin/stat", path], capture_output=True)
                if probe.returncode == 0:
                    raise RuntimeError(f"Sandbox did not conceal checkout: {path}")
        print("Verified source/build reads are denied to the test process.", flush=True)

        home.mkdir()
        project.mkdir()
        # An empty repository avoids developer config, hooks, and project commands.
        run("/usr/bin/git", "-c", "init.templateDir=", "init", "--quiet", str(project))
        environment = dict(os.environ)
        for key in list(environment):
            if (key.startswith("CHERRY_") or key.startswith("GHOSTTY_")
                    or key.startswith("DYLD_") or key in {"BASH_ENV", "ENV", "CDPATH"}):
                environment.pop(key)
        environment.update({
            "HOME": str(home),
            "CFFIXED_USER_HOME": str(home),
            "XDG_CONFIG_HOME": str(home / ".config"),
            "XDG_DATA_HOME": str(home / ".local/share"),
            "XDG_STATE_HOME": str(home / ".local/state"),
            "ZDOTDIR": str(home),
            "SHELL": "/bin/zsh",
            "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            "CHERRY_CONTROL_SOCKET": str(socket_path),
            "CHERRY_TERMINAL_PERF": "1",
            "CHERRY_PERF_PROJECT_ROOTS": str(project),
        })
        if not args.skip_helpers:
            exercise_helpers(app, sandbox, environment, fixture)
            cli = app / "Contents/MacOS/cherry"
        # Only the GUI gets the host socket; exercise_helpers passes --socket.
        gui_environment = dict(environment, CHERRY_HOST_SOCKET=str(host_socket))
        with log.open("wb") as output:
            process = subprocess.Popen(sandbox + [str(executable)], cwd=fixture,
                                       env=gui_environment, stdout=output, stderr=subprocess.STDOUT,
                                       start_new_session=True)
        deadline = time.monotonic() + args.timeout
        while True:
            check_running(process)
            try:
                control(socket_path, request("listProjects"))
                break
            except (OSError, ValueError, RuntimeError):
                if time.monotonic() >= deadline:
                    raise RuntimeError("Timed out waiting for the packaged GUI control socket")
                time.sleep(0.1)

        def scoped(name, fields=None):
            return control(socket_path, request("scoped", {
                "projectRoot": str(project), "request": request(name, fields)
            }))

        # This initializes GhosttyTerminal.TerminalController through the real
        # app window, including Bundle.module and the native renderer/PTY path.
        control(socket_path, request("openProject", {"projectRoot": str(project)}))
        terminals = scoped("listTerminals")["terminals"]
        terminal_ids.extend(terminal["id"] for terminal in terminals)
        created = scoped("createTerminal", {"title": "Packaged app smoke", "workingDirectory": str(project)})
        terminal_id = created["terminalID"]
        terminal_ids.append(terminal_id)
        scoped("selectTerminal", {"terminalID": terminal_id})
        while True:
            check_running(process)
            initial = scoped("getTerminalOutput", {"terminalID": terminal_id, "lineLimit": 100})
            if any("Ghostty failed to launch" in line for line in initial["lines"]):
                raise RuntimeError(f"Native shell did not launch: {initial['lines']}")
            if any(line.strip() for line in initial["lines"]):
                break
            if time.monotonic() >= deadline:
                raise RuntimeError("Timed out waiting for the native shell's first rendered output")
            time.sleep(0.1)
        # The complete marker never occurs in the input, so echoed input cannot
        # pass this check without the shell actually executing the command.
        marker = "CHERRY_PACKAGED_" + unique
        scoped("sendInput", {"terminalID": terminal_id,
                             "text": "printf '\\n%s%s\\n' 'CHERRY_PACKAGED_' '" + unique + "'\n"})
        while True:
            check_running(process)
            output = scoped("getTerminalOutput", {"terminalID": terminal_id, "lineLimit": 100})
            if any(line.strip() == marker for line in output["lines"]):
                break
            if time.monotonic() >= deadline:
                raise RuntimeError(f"Shell marker did not appear in rendered Ghostty screen: {output}")
            time.sleep(0.1)
        if cli is not None:
            # New local tabs are persistent sessions on the bundled host, the
            # one on the private socket; without the helpers they are native.
            owner = info["CherryApplicationSupportName"]
            listed = None
            hosted = []
            deadline = time.monotonic() + 15
            while not hosted:
                check_running(process)
                listed = cherry_private_host.sessions(cli, host_socket, environment, fixture, sandbox)
                hosted = [item for item in listed or []
                          if item.get("owner") == owner and item.get("state") == "running"]
                if hosted:
                    break
                if time.monotonic() >= deadline:
                    raise RuntimeError("The packaged GUI's tabs are not running as persistent sessions on its "
                                       f"bundled host at {host_socket}; the host lists {listed}")
                time.sleep(0.2)
            print(f"Verified the packaged GUI runs its tabs as persistent sessions ({len(hosted)}) "
                  "on its bundled host at a private socket.", flush=True)
        print("PASS: packaged GUI opened a Ghostty terminal and rendered shell output with checkout hidden.",
              flush=True)
        success = True
    finally:
        if process is not None and process.poll() is None:
            for terminal_id in terminal_ids:
                try:
                    control(socket_path, request("scoped", {
                        "projectRoot": str(project),
                        "request": request("closeTerminal", {"terminalID": terminal_id}),
                    }), timeout=1)
                except (OSError, ValueError, RuntimeError):
                    pass
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=5)
        # End the GUI's sessions and daemon, and stop its holders and attach
        # adapters: the fixture's unique name is in all their command lines.
        try:
            leftover = cherry_private_host.stop(cli, host_socket, environment or {}, cwd=fixture,
                                                prefix=sandbox or (), markers=[fixture.name])
        except (OSError, subprocess.SubprocessError) as error:
            leftover = [f"cleanup failed: {error}"]
        if bundle_id:
            # cfprefsd keeps the smoke copy's preferences in the user's own
            # ~/Library/Preferences, whatever CFFIXED_USER_HOME says.
            subprocess.run(["/usr/bin/defaults", "delete", bundle_id], capture_output=True)
            (Path.home() / "Library/Preferences" / f"{bundle_id}.plist").unlink(missing_ok=True)
        if not success and log.exists():
            print("Packaged GUI log (last 8 KB):\n" + log.read_text(errors="replace")[-8192:], file=sys.stderr)
        host_log = cherry_private_host.state_dir(home, host_socket) / "host.log"
        if not success and host_log.exists():
            print("GUI session host log (last 8 KB):\n" + host_log.read_text(errors="replace")[-8192:],
                  file=sys.stderr)
        if args.keep_fixture:
            print(f"Fixture retained at {fixture}", flush=True)
        else:
            shutil.rmtree(fixture)
        if leftover:
            print("Packaged GUI session host cleanup: " + "; ".join(leftover), file=sys.stderr)
            if success:
                raise RuntimeError("The packaged GUI left processes or state behind: " + "; ".join(leftover))


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr, file=sys.stderr)
        sys.exit(1)
