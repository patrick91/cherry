{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cherry-attention-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cherry-attention-lab",
      "database_id": "f3a202fc-02fc-4b7e-b9b9-69bd07cbba22",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "DASHBOARD_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
